    "theme:link": "npx --yes @voyant-travel/cli@1.3.0 theme link",
    "theme:status": "npx --yes @voyant-travel/cli@1.3.0 theme status",
    "theme:unlink": "npx --yes @voyant-travel/cli@1.3.0 theme unlink",
    "theme:check": "npx --yes @voyant-travel/cli@1.3.0 theme check",
    "build": "npx --yes @voyant-travel/cli@1.3.0 theme build",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "preview": "astro preview"
  },
