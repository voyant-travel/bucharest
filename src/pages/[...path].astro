---
import CollectionValue from "../components/CollectionValue.astro"
import ArticleEntryPage from "../components/collection/ArticleEntryPage.astro"
import DestinationPage from "../components/destination/DestinationPage.astro"
import DestinationIndexPage from "../components/destination-index/DestinationIndexPage.astro"
import CruisePage from "../components/CruisePage.astro"
import PageLead from "../components/primitives/PageLead.astro"
import HomeSections from "../components/sections/HomeSections.astro"
import TourDetail from "../components/TourDetail.astro"
import TourIndex from "../components/TourIndex.astro"
import Layout from "../layouts/Layout.astro"
import {
  entryBlurb,
  entryFields,
} from "../lib/collection-values"
import { readDestination } from "../lib/destination"
import { readDestinationIndex } from "../lib/destination-index"
import { fill, messagesFor } from "../lib/messages"
import { readSettings } from "../lib/site"
import { composedPageSections } from "../lib/sections"
import { isKnownSection, opensFullBleed } from "../lib/section-registry"
import { resolveThemeContext } from "virtual:voyant-theme"

// Context is resolved per request. On a published hostname it comes from the
// immutable publication snapshot bound to this Worker; locally it falls back to
// the fixtures in theme.config.ts. A partially configured runtime fails closed
// rather than serving fixtures publicly.
const context = await resolveThemeContext(Astro.url)
if (context.kind === "notFound") Astro.response.status = 404

const t = messagesFor(context.locale)

/*
 * A collection entry belongs somewhere. Its parent path is the listing it was
 * reached from, which is the only "back" a reader can be offered without the
 * theme inventing a route the operator has not published.
 */
const collection = "collection" in context ? context.collection : undefined
const entryParent =
  context.kind === "collectionEntry"
    ? context.path.slice(0, context.path.lastIndexOf("/")) || "/"
    : undefined
const isArticleEntry =
  context.kind === "collectionEntry" && context.templateId === "article"

/*
 * A destination page is a content page the platform assigned an alternate
 * template to. The theme branches on the id it was given rather than sniffing
 * the path or the settings: which pages read as places is the operator's
 * decision, published through assignment rules the theme never sees.
 */
const isDestination =
  context.kind === "content" && context.templateId === "destination"
const destination = isDestination ? readDestination(context.settings) : undefined

/* The listing that gathers those pages. Same seam, a second template id. */
const isDestinationIndex =
  context.kind === "content" && context.templateId === "destination-index"
const destinationIndex = isDestinationIndex
  ? readDestinationIndex(context.settings)
  : undefined
const { phone: sitePhone, bookingUrl: siteBookingUrl } = readSettings(
  context.settings,
)

const authoredSections = composedPageSections(context).filter((section) =>
  isKnownSection(section.type),
)
const rendersAuthoredContent =
  context.kind === "content" &&
  authoredSections.length > 0 &&
  !isDestination &&
  !isDestinationIndex
/**
 * Whether the header may sit over the page rather than above it. Only true
 * when the first thing on the page is a hero that actually carries a
 * photograph filling the top of the window.
 */
const firstSection = authoredSections[0]
const overHero = firstSection
  ? opensFullBleed(firstSection.type, firstSection.data.settings)
  : false


// A listing shows the first text a reader can scan, so an index is not a wall
// of bare titles. "First" follows the operator's declared order when the
// collection publishes one, so the summary they put at the top is the summary
// that appears; otherwise it falls back to sorted keys, which is the best
// `values` alone can offer.

---

<Layout
  context={context}
  authoredHome={authoredSections.length > 0}
  overHero={overHero}
>
  {(context.kind === "home" || rendersAuthoredContent) && authoredSections.length > 0 && (
    <HomeSections
      sections={authoredSections}
      locale={context.locale}
    />
  )}
  {context.kind === "home" && authoredSections.length === 0 && <h1>{context.title}</h1>}
  {["content", "notFound", "collectionIndex", "collectionEntry"].includes(
    context.kind,
  ) &&
    !isDestination &&
    !isDestinationIndex &&
    !rendersAuthoredContent &&
    !isArticleEntry && (
    <PageLead
      title={context.title}
      eyebrow={context.kind === "collectionIndex" ? collection?.name : undefined}
      backHref={entryParent}
      backLabel={
        collection && entryParent
          ? fill(t.backTo, { name: collection.name })
          : undefined
      }
    />
  )}
  {isDestination && destination && (
    <DestinationPage
      destination={destination}
      title={context.title}
      phone={sitePhone}
      enquiryHref={destination.enquiryHref}
      locale={context.locale}
    />
  )}
  {isDestinationIndex && destinationIndex && (
    <DestinationIndexPage
      index={destinationIndex}
      title={context.title}
      phone={sitePhone}
      locale={context.locale}
    />
  )}
  {context.kind === "collectionEntry" && isArticleEntry && entryParent && (
    <ArticleEntryPage
      context={context}
      backHref={entryParent}
      backLabel={fill(t.backTo, { name: context.collection.name })}
    />
  )}
  {context.kind === "content" && !isDestination && !isDestinationIndex && !rendersAuthoredContent && (
    <div class="u-shell pb-24 md:pb-32">
      {context.summary && (
        <p class="u-serif-body max-w-[42rem] text-[1.25rem] leading-[1.55] text-ink md:text-[1.4375rem]">
          {context.summary}
        </p>
      )}
      <div class="prose mt-8 max-w-[44rem]">
        <p>{context.body}</p>
      </div>
    </div>
  )}
  {context.kind === "notFound" && (
    <div class="u-shell pb-28 md:pb-40">
      {context.message && (
        <p class="u-serif-body max-w-[36rem] text-[1.125rem] leading-[1.6] text-ink-muted">
          {context.message}
        </p>
      )}
      <a
        href="/"
        class="mt-10 inline-flex h-11 items-center rounded-pill bg-accent px-6 text-[0.875rem] font-medium text-accent-ink transition-colors duration-300 hover:bg-accent-hover"
      >
        {fill(t.backTo, { name: context.site.name })}
      </a>
    </div>
  )}
  {context.kind === "tourIndex" && <TourIndex context={context} />}
  {context.kind === "tourDetail" && <TourDetail context={context} />}
  {(context.kind === "cruiseIndex" ||
    context.kind === "cruiseDetail" ||
    context.kind === "shipDetail" ||
    context.kind === "sailingDetail") && (
    <CruisePage context={context} />
  )}

  {
    /*
     * Dynamic lists the operator placed on this page. Distinct from a
     * collection's own index: the collection need not be routable, so an entry
     * here may legitimately have no page to link to.
     */
    "collectionLists" in context &&
      context.collectionLists?.map((list) => (
        <section class="u-shell pb-16">
          {list.title && (
            <h2 class="u-eyebrow text-ink-subtle">{list.title}</h2>
          )}
          {list.entries.length === 0 ? (
            <p class="mt-6 text-[0.9375rem] text-ink-subtle">{t.nothingPublished}</p>
          ) : (
            <ul class="mt-6 border-t border-line">
              {list.entries.map((entry) => {
                const summary = entryBlurb(entry, list.collection.fields)
                return (
                  <li class="border-b border-line py-5">
                    <h3 class="u-display-sm text-[1.125rem] md:text-[1.25rem]">
                      {entry.path ? (
                        <a
                          href={entry.path}
                          class="transition-opacity duration-300 hover:opacity-65"
                        >
                          {entry.title}
                        </a>
                      ) : (
                        entry.title
                      )}
                    </h3>
                    {summary && (
                      <p class="mt-2 max-w-[46rem] text-[0.9375rem] leading-relaxed text-ink-muted">
                        {summary}
                      </p>
                    )}
                  </li>
                )
              })}
            </ul>
          )}
        </section>
      ))
  }

  {
    context.kind === "collectionIndex" && (
      <div class="u-shell pb-24 md:pb-32">
        {context.entries.length === 0 ? (
          <p class="u-serif-body text-[1.125rem] text-ink-subtle">
            {t.nothingPublished}
          </p>
        ) : (
          <ul class="border-t border-line">
            {context.entries.map((entry) => {
              const summary = entryBlurb(entry, context.collection.fields)
              return (
                <li class="border-b border-line">
                  {entry.path ? (
                    <a
                      href={entry.path}
                      class="group block py-7 transition-opacity duration-300 hover:opacity-70"
                    >
                      <h2 class="u-display-sm text-[1.375rem] md:text-[1.5rem]">
                        {entry.title}
                      </h2>
                      {summary && (
                        <p class="mt-2.5 max-w-[46rem] text-[0.9375rem] leading-relaxed text-ink-muted">
                          {summary}
                        </p>
                      )}
                    </a>
                  ) : (
                    <div class="py-7">
                      <h2 class="u-display-sm text-[1.375rem] md:text-[1.5rem]">
                        {entry.title}
                      </h2>
                      {summary && (
                        <p class="mt-2.5 max-w-[46rem] text-[0.9375rem] leading-relaxed text-ink-muted">
                          {summary}
                        </p>
                      )}
                    </div>
                  )}
                </li>
              )
            })}
          </ul>
        )}
      </div>
    )
  }

  {
    context.kind === "collectionEntry" && !isArticleEntry && (
      <div class="u-shell pb-24 md:pb-32">
        <dl class="max-w-[52rem] border-t border-line">
          {entryFields(context.entry.values, context.collection.fields).map((field) => (
            <div class="grid gap-1.5 border-b border-line py-5 md:grid-cols-12 md:gap-8">
              <dt class="u-eyebrow text-ink-subtle md:col-span-3 md:pt-1">
                {field.label}
              </dt>
              <dd class="m-0 text-[0.9375rem] leading-relaxed md:col-span-9">
                <CollectionValue value={field.value} />
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }
</Layout>
