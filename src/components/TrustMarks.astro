---
/**
 * The marks a travel agency has to, or wants to, show.
 *
 * Three classes, kept visually apart because conflating them is a trust claim
 * the operator has not earned. The consumer-protection marks are a legal duty
 * with a prescribed destination. Membership marks are voluntary and belong to
 * bodies that licensed their own artwork. Payment marks say how you can pay,
 * which is not an accreditation at all.
 *
 * Artwork is uploaded, never drawn here: card schemes and associations publish
 * their marks under their own licences, and a redrawn Visa is both wrong and a
 * licensing problem. What stays as text is what is genuinely words — paying in
 * instalments, paying in branch — because a logo for "plata în rate" is a logo
 * somebody would have to invent.
 */
import { cn } from "~/lib/cn"
import type { Messages } from "~/lib/messages"
import type { SiteSettings } from "~/lib/site"

interface Props {
  settings: SiteSettings
  /*
   * The theme's own words for these blocks. ANPC and SAL are Romanian bodies
   * and keep their names, but "Consumer protection" is a description the
   * reader needs in their own language — leaving it Romanian on an English
   * page is how a compliance block starts looking like boilerplate nobody read.
   */
  messages: Messages
  class?: string
}

const { settings, messages, class: className } = Astro.props

/**
 * The consumer-protection marks, by scheme version.
 *
 * SOL is present only under `ro-2022`, and labelled, because the EU ODR
 * platform it points at was switched off on 20 July 2025 under Regulation (EU)
 * 2024/3228 — a site still serving that badge is linking a consumer to
 * nothing. ANPC's own framework dropped it in the 2026 amendment.
 */
const MARKS = {
  "ro-2026": [
    { id: "anpc", label: "ANPC", href: "https://anpc.ro/", note: messages.consumerProtection },
    {
      id: "anpc-sal",
      label: "SAL",
      href: "https://reclamatiisal.anpc.ro",
      note: messages.disputeResolution,
    },
  ],
  "ro-2022": [
    { id: "anpc", label: "ANPC", href: "https://anpc.ro/", note: messages.consumerProtection },
    {
      id: "anpc-sal",
      label: "SAL",
      href: "https://reclamatiisal.anpc.ro",
      note: messages.disputeResolution,
    },
    {
      id: "anpc-sol",
      label: "SOL",
      href: "https://ec.europa.eu/consumers/odr",
      note: messages.markWithdrawn,
      withdrawn: true,
    },
  ],
  none: [],
} as const

const marks = MARKS[settings.marks] ?? []
const { paymentBadges, partnerBadges, payment } = settings
const anything =
  marks.length > 0 ||
  paymentBadges.length > 0 ||
  partnerBadges.length > 0 ||
  payment.length > 0
---

{
  anything && (
    <div class={cn("grid gap-10", className)}>
      {partnerBadges.length > 0 && (
        <div>
          <p class="u-eyebrow text-ink-subtle">{messages.accreditations}</p>
          <ul class="mt-4 flex flex-wrap items-center gap-x-8 gap-y-5">
            {partnerBadges.map((badge) => (
              <li>
                {badge.href ? (
                  <a href={badge.href} rel="noopener" target="_blank">
                    <img
                      src={badge.src}
                      alt={badge.alt}
                      loading="lazy"
                      decoding="async"
                      /*
                       * Capped by height, never by width: these arrive at
                       * whatever aspect their owner publishes, and forcing a
                       * box distorts a mark somebody licensed.
                       */
                      class="h-9 w-auto max-w-[10rem] object-contain opacity-70 transition-opacity duration-500 hover:opacity-100"
                    />
                  </a>
                ) : (
                  <img
                    src={badge.src}
                    alt={badge.alt}
                    loading="lazy"
                    decoding="async"
                    class="h-9 w-auto max-w-[10rem] object-contain opacity-70"
                  />
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="grid gap-8 md:grid-cols-[auto_1fr] md:items-start md:gap-14">
        {marks.length > 0 && (
          <div>
            <p class="u-eyebrow text-ink-subtle">{messages.consumerProtection}</p>
            <ul class="mt-4 flex flex-wrap items-center gap-2">
              {marks.map((mark) => (
                <li>
                  <a
                    href={mark.href}
                    rel="noopener nofollow"
                    target="_blank"
                    title={mark.note}
                    class={cn(
                      /*
                       * 250×50 is the size the order prescribes for these
                       * marks, halved for a footer; the ratio is what matters
                       * when official artwork replaces the placeholder.
                       */
                      "flex h-[42px] w-[125px] flex-col items-center justify-center rounded-card border text-center transition-colors duration-300",
                      "withdrawn" in mark && mark.withdrawn
                        ? "border-dashed border-ink-subtle/50 text-ink-subtle"
                        : "border-line text-ink-muted hover:border-ink/40 hover:text-ink",
                    )}
                  >
                    <span class="text-[0.8125rem] font-medium tracking-[0.08em]">
                      {mark.label}
                    </span>
                    {"withdrawn" in mark && mark.withdrawn && (
                      <span class="text-[0.5625rem] uppercase tracking-[0.1em]">
                        {messages.withdrawnShort}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {(paymentBadges.length > 0 || payment.length > 0) && (
          <div>
            <p class="u-eyebrow text-ink-subtle">{messages.paymentHeading}</p>
            <ul class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
              {paymentBadges.map((badge) => (
                <li>
                  <img
                    src={badge.src}
                    alt={badge.alt}
                    loading="lazy"
                    decoding="async"
                    class="h-7 w-auto max-w-[4.5rem] object-contain"
                  />
                </li>
              ))}
              {
                /*
                 * Words stay words. Instalments and paying in branch are two
                 * of the largest reasons a Romanian traveller books at all,
                 * and neither has a logo to show.
                 */
              }
              {payment.map((method) => (
                <li class="rounded-card border border-line px-3 py-1.5 text-[0.8125rem] text-ink-muted">
                  {method}
                </li>
              ))}
            </ul>
            {settings.paymentNote && (
              <p class="mt-3 text-[0.75rem] text-ink-subtle">{settings.paymentNote}</p>
            )}
          </div>
        )}
      </div>
    </div>
  )
}
