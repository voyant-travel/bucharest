---
import LegalIdentity from "~/components/LegalIdentity.astro"
import NewsletterSignup from "~/components/islands/NewsletterSignup"
import { CurrencyPicker, LanguagePicker } from "~/components/islands/LocalePickers"
import TrustMarks from "~/components/TrustMarks.astro"
import { cn } from "~/lib/cn"
import type { Messages } from "~/lib/messages"
import type { MenuItem, SiteSettings } from "~/lib/site"
import { telHref } from "~/lib/site"

interface Props {
  siteName: string
  logo?: { src: string; alt: string } | undefined
  columns: Array<{ title?: string; items: MenuItem[] }>
  settings: SiteSettings
  fallbackItems: MenuItem[]
  messages: Messages
}

const { siteName, logo, columns, settings, fallbackItems, messages } = Astro.props

/** A site with no footer menus still gets a sitemap, from the primary nav. */
const resolved =
  columns.length > 0 ? columns : fallbackItems.length > 0 ? [{ items: fallbackItems }] : []

const year = new Date().getFullYear()

/**
 * How many columns the menus get.
 *
 * `auto` follows what the operator published, which is right until they
 * publish five menus of wildly different lengths; the explicit setting is the
 * escape hatch for that. Capped at six — beyond that the links are narrower
 * than the words in them.
 */
const columnCount =
  settings.footerColumns === "auto"
    ? Math.min(resolved.length, 6)
    : Number(settings.footerColumns)

const COLUMN_CLASS: Record<number, string> = {
  1: "grid-cols-1",
  2: "grid-cols-2",
  3: "grid-cols-2 md:grid-cols-3",
  4: "grid-cols-2 lg:grid-cols-4",
  5: "grid-cols-2 md:grid-cols-3 lg:grid-cols-5",
  6: "grid-cols-2 md:grid-cols-3 lg:grid-cols-6",
}

const columnClass = COLUMN_CLASS[Math.max(1, Math.min(columnCount, 6))]

/**
 * Brand marks, drawn to be filled.
 *
 * These are the one place in the theme that does not use the hairline stroke
 * set: a wordmark outlined at 1.35px reads as a smudge at 16px, and a
 * recognisable logo is the entire job of a social icon. They are drawn solid
 * and sized down instead.
 */
