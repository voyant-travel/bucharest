  facebook:
    "M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.9h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z",
  youtube:
    "M21.58 7.19a2.51 2.51 0 0 0-1.77-1.77C18.25 5 12 5 12 5s-6.25 0-7.81.42a2.51 2.51 0 0 0-1.77 1.77C2 8.75 2 12 2 12s0 3.25.42 4.81c.23.86.9 1.54 1.77 1.77C5.75 19 12 19 12 19s6.25 0 7.81-.42a2.51 2.51 0 0 0 1.77-1.77C22 15.25 22 12 22 12s0-3.25-.42-4.81ZM10 15.02V8.98L15.2 12 10 15.02Z",
  linkedin:
    "M6.94 8.9v11.4H3.15V8.9h3.79Zm.24-3.52c0 1.09-.82 1.96-2.14 1.96h-.02c-1.27 0-2.09-.87-2.09-1.96 0-1.11.85-1.96 2.14-1.96 1.29 0 2.09.85 2.11 1.96ZM20.6 13.76v6.54h-3.78v-6.1c0-1.53-.55-2.58-1.92-2.58-1.05 0-1.67.7-1.95 1.39-.1.24-.12.58-.12.92v6.37H9.04s.05-10.34 0-11.41h3.79v1.62l-.03.04h.03v-.04c.5-.78 1.4-1.89 3.41-1.89 2.49 0 4.36 1.63 4.36 5.14Z",
}
---

<footer class="border-t border-line bg-canvas">
  {
    /*
     * The newsletter opens the footer, on its own ground.
     *
     * Both references put it above the columns rather than inside one: it is
     * the only thing down here asking for something instead of offering it,
     * and a column is where a reader has already stopped looking.
     */
  }
  {
    settings.newsletter && (
      <div class="border-b border-line bg-surface-sunk">
        <div class="u-shell grid gap-8 py-12 md:grid-cols-2 md:items-center md:py-14">
          <div>
            <h2 class="u-display-sm text-[1.5rem] md:text-[1.75rem]">
              {settings.newsletter.heading}
            </h2>
            {settings.newsletter.body && (
              <p class="mt-3 max-w-[34rem] text-[0.9375rem] leading-relaxed text-ink-muted">
                {settings.newsletter.body}
              </p>
            )}
          </div>
          <div class="md:justify-self-end">
            <NewsletterSignup
              client:visible
              copy={{
                ...settings.newsletter,
                emailPlaceholder: messages.emailPlaceholder,
                sending: messages.sending,
                done: messages.subscribeDone,
                failed: messages.subscribeFailed,
                notConnected: messages.subscribeNotConnected,
              }}
            />
          </div>
        </div>
      </div>
    )
  }

  <div class="u-shell py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4 lg:col-span-3">
        <a href="/" class="inline-flex items-center" aria-label={siteName}>
          {
            logo ? (
              <img
                src={logo.src}
                alt={logo.alt || siteName}
                class="h-8 w-auto max-w-[12rem] object-contain"
              />
            ) : (
              <span class="u-display-sm text-[1.5rem]">{siteName}</span>
            )
          }
        </a>

        {
          (settings.phone || settings.email || settings.address) && (
            <address class="mt-7 space-y-2.5 not-italic text-[0.875rem] leading-relaxed text-ink-muted">
              {settings.address && <p class="max-w-[16rem]">{settings.address}</p>}
              {settings.phone && (
                <p>
                  <a href={telHref(settings.phone)} class="u-link">
                    {settings.phone}
                  </a>
                </p>
              )}
              {settings.email && (
                <p>
                  <a href={`mailto:${settings.email}`} class="u-link">
                    {settings.email}
                  </a>
                </p>
              )}
            </address>
          )
        }

        {
          settings.social.length > 0 && (
            <ul class="mt-7 flex items-center gap-2">
              {settings.social.map((entry) => (
                <li>
                  <a
                    href={entry.href}
                    rel="me noopener"
                    aria-label={entry.name}
                    class="grid h-10 w-10 place-items-center rounded-pill border border-line text-ink-muted transition-colors duration-400 hover:border-ink/40 hover:text-ink"
                  >
                    <svg
                      class="h-[15px] w-[15px]"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d={SOCIAL_PATHS[entry.icon]} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        resolved.length > 0 && (
          <nav
            class={cn(
              "grid gap-10 md:col-span-8 lg:col-span-9",
              /*
               * Up to six, because a mass-market operator publishes company,
               * customer, booking, policy and partner menus and squeezing
               * those into four produces columns of fourteen links. Two on a
               * phone throughout: one column of sixty links is not a footer.
               */
              columnClass,
            )}
            aria-label={messages.footerNav}
          >
            {resolved.map((column) => (
              <div>
                {column.title && (
                  <h2 class="u-eyebrow text-ink-subtle">{column.title}</h2>
                )}
                <ul class={cn("space-y-3", column.title && "mt-5")}>
                  {column.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-[0.9375rem] text-ink-muted transition-colors duration-300 hover:text-ink"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        )
      }
    </div>

    {
      /*
       * Trust marks sit between the menus and the identity block: they are the
       * visual claim, and the plain text under them is the evidence for it.
       */
    }
    <TrustMarks settings={settings} messages={messages} class="mt-16 border-t border-line pt-10" />

    <LegalIdentity settings={settings} />

    <div class="mt-10 flex flex-col gap-4 border-t border-line pt-8 text-[0.8125rem] text-ink-subtle md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} {siteName}</p>
      {settings.footerNote && <p class="max-w-[42rem]">{settings.footerNote}</p>}

      {
        /*
         * The same two controls as the header, and the same components. A
         * reader who scrolled past the top of the page should not have to
         * scroll back to change language, and a second implementation of a
         * switcher is a second thing to keep in step.
         */
      }
      {settings.footerLocaleControls && (
        <div class="flex items-center gap-5">
          <LanguagePicker client:visible languages={settings.languages} label={messages.language} />
          {settings.currencyMode === "switcher" && (
            <CurrencyPicker client:visible currencies={settings.currencies} label={messages.currency} />
          )}
        </div>
      )}
    </div>
  </div>
</footer>
