---
/**
 * A tour, as a product page.
 *
 * The anatomy is the one a tour operator's product page actually needs:
 * a cinematic lead, a sticky in-page nav, then the editorial sections in the
 * order a reader asks about them — what it is, what happens each day, what is
 * included, where it goes — with the live booking panel alongside.
 *
 * No price or departure date is read from the publication. The contract strips
 * commercial values from a snapshot on purpose, so everything commercial in
 * the sidebar is fetched live from the capability endpoints at request time.
 */
import type { TourDetailContext } from "@voyant-travel/theme"
import Photo from "~/components/primitives/Photo.astro"
import { cn } from "~/lib/cn"
import {
  coverOf,
  daysOf,
  faqsOf,
  featuresOf,
  galleryOf,
  humanize,
  namesOf,
  productSections,
} from "~/lib/catalog"
import { availableCapability } from "~/lib/tour-capabilities"
import BookingJourney from "./BookingJourney.astro"

interface Props {
  context: TourDetailContext
}

const { context } = Astro.props
const { product } = context

const availability = availableCapability(context.live, "catalog.availability.v1")
const pricing = availableCapability(context.live, "catalog.pricing.v1")
const booking = availableCapability(context.live, "booking.session.v1")
const checkout = availableCapability(context.live, "checkout.v1")

const cover = coverOf(product)
const gallery = galleryOf(product)
const days = daysOf(product.itinerary)
const features = featuresOf(product.features)
const faqs = faqsOf(product.faqs)
const destinations = namesOf(product.destinations)
const categories = namesOf(product.categories)
const sections = productSections(product)

const facts = [
  destinations.length > 0
    ? { label: "Where", value: destinations.join(" · ") }
    : undefined,
  days.length > 0
    ? { label: "Length", value: `${days.length} ${days.length === 1 ? "day" : "days"}` }
    : undefined,
  { label: "Format", value: humanize(product.bookingMode) },
  { label: "Capacity", value: humanize(product.capacityMode) },
].filter((fact): fact is { label: string; value: string } => fact !== undefined)

const sectionHeading = "u-display-sm text-[1.625rem] md:text-[2rem]"
---

<article>
  {
    cover ? (
      <header class="u-frame u-scrim-hero u-scrim-top relative flex min-h-[26rem] items-end md:min-h-[40rem]">
        <Photo src={cover.src} alt={cover.alt} class="absolute inset-0" priority sizes="100vw" decorative />
        <div class="u-shell relative z-[2] w-full pb-12 pt-32 md:pb-16">
          <nav aria-label="Breadcrumb">
            <a
              href="/tours"
              class="u-eyebrow inline-flex items-center gap-2.5 text-white/80 transition-opacity duration-300 hover:opacity-70"
            >
              <span class="h-px w-5 bg-current" aria-hidden="true" />
              All journeys
            </a>
          </nav>
          {destinations.length > 0 && (
            <p class="u-eyebrow mt-6 text-white/75">{destinations.join(" · ")}</p>
          )}
          <h1 class="u-display mt-4 max-w-[20ch] text-[2.25rem] text-white sm:text-[3rem] md:text-[3.875rem]">
            {product.name}
          </h1>
          {categories.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
              {categories.map((category) => (
                <li class="u-eyebrow rounded-pill border border-white/35 px-4 py-2 text-white/85">
                  {category}
                </li>
              ))}
            </ul>
          )}
        </div>
      </header>
    ) : (
      <header class="u-shell pb-10 pt-16 md:pt-24">
        <nav aria-label="Breadcrumb">
          <a
            href="/tours"
            class="u-eyebrow inline-flex items-center gap-2.5 text-ink-subtle transition-opacity duration-300 hover:opacity-65"
          >
            <span class="h-px w-5 bg-current" aria-hidden="true" />
            All journeys
          </a>
        </nav>
        {destinations.length > 0 && (
          <p class="u-eyebrow mt-6 text-ink-subtle">{destinations.join(" · ")}</p>
        )}
        <h1 class="u-display mt-4 max-w-[20ch] text-[2.25rem] sm:text-[3rem] md:text-[3.875rem]">
          {product.name}
        </h1>
      </header>
    )
  }

  {
    /*
     * The in-page nav is built from the sections this product can actually
     * fill, so a tour with no itinerary never advertises a link that scrolls
     * nowhere. It scrolls horizontally on a phone rather than wrapping into
     * three rows above the content.
     */
    sections.length > 1 && (
      <nav
        class="sticky top-[4.5rem] z-30 border-b border-line bg-[var(--canvas)]/92 backdrop-blur-lg md:top-[5.25rem]"
        aria-label="On this page"
      >
        <div class="u-shell">
          <ul class="u-no-scrollbar -mx-5 flex gap-1 overflow-x-auto px-5 md:mx-0 md:px-0">
            {sections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  class="inline-flex h-12 items-center whitespace-nowrap px-4 text-[0.8125rem] text-ink-muted transition-colors duration-300 hover:text-ink"
                >
                  {section.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }

  <div class="u-shell py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7 xl:col-span-8">
        {
          product.shortDescription && (
            <p class="u-serif-body text-[1.25rem] leading-[1.55] text-ink md:text-[1.5rem]">
              {product.shortDescription}
            </p>
          )
        }

        {
          facts.length > 0 && (
            <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-7 border-y border-line py-8 sm:grid-cols-4">
              {facts.map((fact) => (
                <div>
                  <dt class="u-eyebrow text-ink-subtle">{fact.label}</dt>
                  <dd class="u-serif-body mt-2.5 text-[1.0625rem]">{fact.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          product.descriptionHtml && (
            <section id="overview" class="mt-14 scroll-mt-40">
              <h2 class={sectionHeading}>Overview</h2>
              <div class="prose mt-6" set:html={product.descriptionHtml} />
            </section>
          )
        }

        {
          days.length > 0 && (
            <section id="itinerary" class="mt-14 scroll-mt-40">
              <h2 class={sectionHeading}>Itinerary</h2>
              {
                /*
                 * Days are a numbered list joined by a rule rather than a stack
                 * of cards: an itinerary is read in sequence, and the through
                 * line is the point of it.
                 */
              }
              <ol class="mt-8 border-t border-line">
                {days.map((day) => (
                  <li class="grid gap-3 border-b border-line py-7 md:grid-cols-12 md:gap-8">
                    <div class="md:col-span-3">
                      <p class="u-eyebrow text-accent">Day {day.dayNumber}</p>
                      {day.location && (
                        <p class="mt-2 text-[0.8125rem] text-ink-subtle">{day.location}</p>
                      )}
                    </div>
                    <div class="md:col-span-9">
                      {day.title && (
                        <h3 class="u-display-sm text-[1.25rem] md:text-[1.375rem]">{day.title}</h3>
                      )}
                      {day.description && (
                        <p class="mt-3 text-[0.9375rem] leading-[1.75] text-ink-muted">
                          {day.description}
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          features.length > 0 && (
            <section id="included" class="mt-14 scroll-mt-40">
              <h2 class={sectionHeading}>What's included</h2>
              <ul class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2">
                {features.map((feature) => (
                  <li class="flex gap-4">
                    <span
                      class="mt-2 h-1.5 w-1.5 shrink-0 rounded-pill bg-accent"
                      aria-hidden="true"
                    />
                    <div>
                      <h3 class="text-[0.9375rem] font-medium">{feature.title}</h3>
                      {feature.description && (
                        <p class="mt-1.5 text-[0.875rem] leading-relaxed text-ink-muted">
                          {feature.description}
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          destinations.length > 0 && (
            <section id="destinations" class="mt-14 scroll-mt-40">
              <h2 class={sectionHeading}>Where you go</h2>
              <ul class="mt-8 flex flex-wrap gap-2.5">
                {destinations.map((destination) => (
                  <li class="rounded-pill border border-line px-5 py-2.5 text-[0.875rem] text-ink-muted">
                    {destination}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          gallery.length > 0 && (
            <section id="gallery" class="mt-14 scroll-mt-40">
              <h2 class={sectionHeading}>Gallery</h2>
              <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
                {gallery.map((photo) => (
                  <li>
                    <Photo
                      src={photo.src}
                      alt={photo.alt}
                      ratio="aspect-[4/3]"
                      class="rounded-card"
                      sizes="(min-width: 768px) 30vw, 46vw"
                    />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          faqs.length > 0 && (
            <section id="questions" class="mt-14 scroll-mt-40">
              <h2 class={sectionHeading}>Questions</h2>
              <div class="mt-8 border-t border-line">
                {faqs.map((faq) => (
                  <details name={`tour-faq-${product.id}`} class="group border-b border-line">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                      <span class="u-serif-body text-[1.0625rem] leading-snug md:text-[1.1875rem]">
                        {faq.question}
                      </span>
                      <span
                        class="relative mt-1.5 h-3.5 w-3.5 shrink-0 text-ink-subtle"
                        aria-hidden="true"
                      >
                        <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current" />
                        <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current transition-transform duration-400 ease-[var(--ease-out-expo)] group-open:scale-y-0" />
                      </span>
                    </summary>
                    <p class="pb-6 pr-10 text-[0.9375rem] leading-[1.75] text-ink-muted">
                      {faq.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          )
        }
      </div>

      {
        /*
         * The booking panel sticks on wide screens only. On a phone it sits
         * inline after the copy, where a fixed bar would cover the itinerary a
         * reader is trying to read.
         */
      }
      <aside class="lg:col-span-5 xl:col-span-4">
        <div class="lg:sticky lg:top-40 lg:space-y-4">
          {
            /*
             * Dates and price are fetched live and never copied into the
             * published page — the contract strips commercial values from a
             * snapshot on purpose. This card is presentation over those
             * capabilities; it is not a booking engine, and the journey itself
             * is handed to the managed engine below.
             */
            (availability || pricing) && (
              <section
                class="rounded-card border border-line bg-surface p-6 md:p-7"
                data-tour-live
                data-product-id={product.id}
                data-locale={context.locale}
                data-availability-endpoint={availability?.endpoint}
                data-pricing-endpoint={pricing?.endpoint}
              >
                <p class="u-eyebrow text-ink-subtle">Live selling</p>
                <h2 class="u-display-sm mt-3 text-[1.5rem]">Dates and price</h2>
                <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-muted">
                  Checked live, never stored in this page.
                </p>
                <div class="mt-6 flex flex-wrap gap-2.5">
                  {availability && (
                    <button
                      type="button"
                      data-load-availability
                      class="inline-flex h-11 items-center rounded-pill bg-accent px-6 text-[0.875rem] font-medium text-accent-ink transition-colors duration-300 hover:bg-accent-hover"
                    >
                      Check dates
                    </button>
                  )}
                  {pricing && (
                    <button
                      type="button"
                      data-load-pricing
                      class="inline-flex h-11 items-center rounded-pill border border-ink/25 px-6 text-[0.875rem] transition-colors duration-300 hover:border-ink/70"
                    >
                      Preview price
                    </button>
                  )}
                </div>
                <p
                  data-live-status
                  aria-live="polite"
                  class="mt-5 text-[0.8125rem] text-ink-subtle empty:hidden"
                />
                <div data-live-result class="mt-4 text-[0.875rem]" />
              </section>
            )
          }

          {
            booking && (
              <div class="[&_.booking-journey]:rounded-card">
                <BookingJourney
                  productId={product.id}
                  locale={context.locale}
                  bookingEndpoint={booking.endpoint}
                  checkoutEndpoint={checkout?.endpoint}
                />
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</article>

<script>
  import { responseRows, rowText } from "../lib/tour-capabilities"

  const card = document.querySelector("[data-tour-live]")
  if (card instanceof HTMLElement) {
    const status = card.querySelector("[data-live-status]")
    const result = card.querySelector("[data-live-result]")
    const productId = card.dataset.productId
    const locale = card.dataset.locale ?? "en"

    const request = async (endpoint, body) => {
      if (!(status instanceof HTMLElement) || !(result instanceof HTMLElement) || !endpoint || !productId) return
      status.textContent = "Checking live inventory…"
      result.replaceChildren()
      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { Accept: "application/json", "Content-Type": "application/json" },
          body: JSON.stringify(body),
        })
        const payload = await response.json().catch(() => null)
        if (!response.ok) {
          const message = payload && typeof payload.error === "string" ? payload.error : `Request failed (${response.status})`
          throw new Error(message.replaceAll("_", " "))
        }
        status.textContent = "Live information updated."
        return payload
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Live selling is temporarily unavailable."
      }
    }

    card.querySelector("[data-load-availability]")?.addEventListener("click", async () => {
      const payload = await request(card.dataset.availabilityEndpoint, { productId, locale })
      if (!payload || !(result instanceof HTMLElement)) return
      const rows = responseRows(payload)
      if (rows.length === 0) {
        result.textContent = "No bookable dates are currently available."
        return
      }
      const list = document.createElement("ul")
      list.className = "live-options"
      for (const row of rows) {
        const item = document.createElement("li")
        const date = rowText(row, "startsAt", "dateLocal", "startDate") ?? "Date to be confirmed"
        const remaining = typeof row.remainingPax === "number" ? `${row.remainingPax} places` : undefined
        const copy = document.createElement("span")
        copy.textContent = remaining ? `${date} · ${remaining}` : date
        item.append(copy)
        const departureSlotId = rowText(row, "id", "slotId", "departureSlotId")
        if (departureSlotId) {
          const choose = document.createElement("button")
          choose.type = "button"
          choose.className = "secondary choose-date"
          choose.textContent = "Choose"
          choose.addEventListener("click", () => {
            document.dispatchEvent(new CustomEvent("voyant:departure-selected", { detail: { departureSlotId } }))
          })
          item.append(choose)
        }
        list.append(item)
      }
      result.append(list)
    })

    card.querySelector("[data-load-pricing]")?.addEventListener("click", async () => {
      const payload = await request(card.dataset.pricingEndpoint, {
        target: { kind: "product", productId },
        scope: { locale, market: "default" },
      })
      if (!payload || !(result instanceof HTMLElement)) return
      const preview = payload.kind === "offer_preview" ? payload.preview : payload
      if (preview?.available !== true || !preview.pricing) {
        result.textContent = "Choose a date and party to receive a price."
        return
      }
      const pre = document.createElement("pre")
      pre.textContent = JSON.stringify(preview.pricing, null, 2)
      result.append(pre)
    })
  }
</script>
