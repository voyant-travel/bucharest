---
/**
 * The handoff into Voyant's managed booking engine.
 *
 * Nothing here is a booking engine. Sessions, quotes, holds and checkout are
 * resolved live against the platform's capabilities; this panel is the shape
 * that conversation takes on the operator's own site, which is why no
 * commercial value it displays is ever read from the publication.
 *
 * Every `data-*` attribute and `data-action` value is read by
 * `booking-journey.mjs`. They are a contract between markup and script, so this
 * file may restyle freely and rename nothing.
 */
import { messagesFor } from "~/lib/messages"

interface Props {
  productId?: string
  locale: string
  bookingEndpoint: string
  checkoutEndpoint?: string
  mode?: "product" | "itinerary"
}

const {
  productId,
  locale,
  bookingEndpoint,
  checkoutEndpoint,
  mode = "product",
} = Astro.props
const itinerary = mode === "itinerary"
const b = messagesFor(locale).booking

/*
 * A page may carry more than one of these — a journey panel and the trip
 * panel inside managed shopping. Two elements answering to `#booking-heading`
 * would make `aria-labelledby` ambiguous, so the id is per instance.
 */
const uid = `booking-${Math.random().toString(36).slice(2, 9)}`

/* Only the strings the journey script writes, travelling with its element. */
const scriptMessages = JSON.stringify({
  notStarted: b.notStarted,
  checkStatus: b.checkStatus,
  continueToCheckout: b.continueToCheckout,
  inProgress: b.inProgress,
  rejected: b.rejected,
  nothingChanged: b.nothingChanged,
  departureSelected: b.departureSelected,
  itineraryCreated: b.itineraryCreated,
})
---

<section
  class="booking-journey"
  data-booking-journey
  data-product-id={productId}
  data-locale={locale}
  data-booking-endpoint={bookingEndpoint}
  data-checkout-endpoint={checkoutEndpoint}
  data-booking-mode={mode}
  data-messages={scriptMessages}
  hidden={itinerary}
  aria-labelledby={uid}
>
  <p class="eyebrow">{itinerary ? b.eyebrowItinerary : b.eyebrowLive}</p>
  <h2 id={uid}>{itinerary ? b.headingItinerary : b.headingLive}</h2>
  <p class="intro">{b.intro}</p>

  <form data-booking-form>
    <div class="fields">
      {!itinerary && (
        <label>
          {b.departureReference}
          <input name="departureSlotId" autocomplete="off" required />
          <span>{b.departureHint}</span>
        </label>
      )}
      <label>
        {b.adults}
        <input name="adults" type="number" min="1" max="20" value="1" required />
      </label>
      <label>
        {b.firstName}
        <input name="firstName" autocomplete="given-name" />
      </label>
      <label>
        {b.lastName}
        <input name="lastName" autocomplete="family-name" />
      </label>
      <label class="wide">
        {b.email}
        <input name="email" type="email" autocomplete="email" />
      </label>
    </div>

    <div class="actions" role="group" aria-label={b.steps}>
      {!itinerary && <button type="submit" data-action="create">{b.start}</button>}
      <button type="button" class="secondary" data-action="update" disabled>{b.update}</button>
      <button type="button" class="secondary" data-action="quote" disabled>{b.getQuote}</button>
      <button type="button" class="secondary" data-action="hold" disabled>{b.holdPlace}</button>
      <button type="button" data-action="commit" disabled>{b.continueToCheckout}</button>
    </div>
    <fieldset data-payment-intents hidden>
      <legend>{b.paymentQuestion}</legend>
      <label><input type="radio" name="paymentIntent" value="card" checked /> {b.card}</label>
      <label><input type="radio" name="paymentIntent" value="bank_transfer" /> {b.bankTransfer}</label>
      <label><input type="radio" name="paymentIntent" value="inquiry" /> {b.inquiry}</label>
    </fieldset>
  </form>

  <div class="session-tools" data-session-tools hidden>
    <button type="button" class="link" data-action="renew">{b.renew}</button>
    <button type="button" class="link danger" data-action="abandon">{b.abandon}</button>
  </div>

  <p class="status" data-booking-status role="status" aria-live="polite"></p>
  <p class="error" data-booking-error role="alert" hidden></p>
  <dl class="live-state" data-live-state hidden>
    <div><dt>{b.stateSession}</dt><dd data-state-session>{b.notStarted}</dd></div>
    <div><dt>{b.stateKind}</dt><dd data-state-kind>{b.waiting}</dd></div>
    <div><dt>{b.stateRevision}</dt><dd data-state-revision>—</dd></div>
    <div><dt>{b.stateQuote}</dt><dd data-state-quote>—</dd></div>
    <div><dt>{b.stateHold}</dt><dd data-state-hold>—</dd></div>
  </dl>
  <p class="handoff" data-checkout-handoff hidden>
    {b.checkoutReady}
    <a rel="nofollow noopener" data-checkout-link>{b.openCheckout}</a>
  </p>
  <button type="button" class="secondary" data-action="checkout" hidden>
    {b.prepareCheckout}
  </button>
</section>

<script>
  import {
    createBookingJourney,
    isContinuableCommitOutcome,
    offeredPaymentIntents,
    readableCode,
    selectionFromForm,
  } from "../lib/booking-journey.mjs"

  for (const root of document.querySelectorAll("[data-booking-journey]")) {
    if (!(root instanceof HTMLElement)) continue
    const form = root.querySelector("[data-booking-form]")
    const status = root.querySelector("[data-booking-status]")
    const error = root.querySelector("[data-booking-error]")
    const stateView = root.querySelector("[data-live-state]")
    const tools = root.querySelector("[data-session-tools]")
    const paymentIntents = root.querySelector("[data-payment-intents]")
    const checkoutButton = root.querySelector('[data-action="checkout"]')
    const handoff = root.querySelector("[data-checkout-handoff]")
    const handoffLink = root.querySelector("[data-checkout-link]")
    const bookingEndpoint = root.dataset.bookingEndpoint
    const productId = root.dataset.productId

    // The words this script writes come from the component, which is the only
    // layer that knows the publication's language.
    const copy = JSON.parse(root.dataset.messages ?? "{}")
    const fill = (template, values) =>
      String(template ?? "").replaceAll(/\{(\w+)\}/g, (match, key) =>
        key in values ? String(values[key]) : match,
      )
    if (form instanceof HTMLFormElement && bookingEndpoint) {
      let journey = productId
        ? createBookingJourney({
            endpoint: bookingEndpoint,
            checkoutEndpoint: root.dataset.checkoutEndpoint,
            productId,
          })
        : undefined
      let lastPayload
      let inFlight = false

      const button = (action) => root.querySelector(`[data-action="${action}"]`)
      const selectedIntent = () => {
        const selected = form.querySelector('input[name="paymentIntent"]:checked')
        return selected instanceof HTMLInputElement ? selected.value : "card"
      }
      const setText = (selector, value) => {
        const node = root.querySelector(selector)
        if (node instanceof HTMLElement) node.textContent = value
      }
      const render = (state) => {
        const pendingCommit = isContinuableCommitOutcome(state.commitOutcome)
        const terminal =
          state.sessionState === "abandoned" ||
          (Boolean(state.commitOutcome) && !pendingCommit)
        const bookingLocked = terminal || pendingCommit
        if (stateView instanceof HTMLElement) stateView.hidden = !state.sessionId
        if (tools instanceof HTMLElement) tools.hidden = !state.sessionId || terminal
        setText("[data-state-session]", state.sessionId ?? copy.notStarted)
        setText("[data-state-kind]", readableCode(state.commitOutcome ?? state.lastOutcome ?? state.sessionState ?? "waiting"))
        setText("[data-state-revision]", state.revision === undefined ? "—" : String(state.revision))
        setText("[data-state-quote]", state.quoteId ?? "—")
        setText("[data-state-hold]", state.holdId ?? "—")
        if (button("create") instanceof HTMLButtonElement) button("create").disabled = Boolean(state.sessionId) && !terminal
        if (button("update") instanceof HTMLButtonElement) button("update").disabled = !state.sessionId || bookingLocked
        if (button("quote") instanceof HTMLButtonElement) button("quote").disabled = !state.sessionId || bookingLocked
        if (button("hold") instanceof HTMLButtonElement) button("hold").disabled = !state.quoteId || bookingLocked
        const commitButton = button("commit")
        if (commitButton instanceof HTMLButtonElement) {
          commitButton.disabled = !state.quoteId || !state.requirementsFingerprint || terminal
          commitButton.textContent = pendingCommit
            ? copy.checkStatus
            : copy.continueToCheckout
        }
        if (paymentIntents instanceof HTMLFieldSetElement) {
          paymentIntents.hidden = !state.quoteId || bookingLocked
        }
        if (button("renew") instanceof HTMLButtonElement) {
          button("renew").disabled = !state.sessionId || bookingLocked
        }
        if (button("abandon") instanceof HTMLButtonElement) {
          button("abandon").disabled = !state.sessionId || bookingLocked
        }
        if (state.handoff && handoff instanceof HTMLElement && handoffLink instanceof HTMLAnchorElement) {
          handoff.hidden = false
          handoffLink.href = state.handoff.url
        }
        const needsCheckout = state.commitOutcome === "payment_required" && !state.handoff && root.dataset.checkoutEndpoint
        if (checkoutButton instanceof HTMLButtonElement) checkoutButton.hidden = !needsCheckout
      }

      const run = async (action) => {
        if (
          inFlight ||
          !journey ||
          !(status instanceof HTMLElement) ||
          !(error instanceof HTMLElement)
        ) return
        inFlight = true
        error.hidden = true
        status.textContent = fill(copy.inProgress, { action: readableCode(action) })
        root.setAttribute("aria-busy", "true")
        const selection = selectionFromForm(form)
        const paymentIntent = selectedIntent()
        try {
          const payment = {
            returnUrl: `${window.location.origin}${window.location.pathname}?checkout=return`,
            cancelUrl: window.location.href,
            acceptedCheckoutHandoffs: ["redirect"],
          }
          const result = await journey.perform(action, {
            selection,
            paymentIntent,
            payment,
            quantity: Number.parseInt(String(new FormData(form).get("adults") ?? "1"), 10) || 1,
          })
          lastPayload = result.payload
          render(result.state)
          const offered = offeredPaymentIntents(lastPayload)
          if (offered.length > 0) {
            for (const input of form.querySelectorAll('input[name="paymentIntent"]')) {
              if (input instanceof HTMLInputElement) input.disabled = !offered.includes(input.value)
            }
          }
          if (result.state.rejection) {
            error.textContent = fill(copy.rejected, {
              reason: readableCode(result.state.rejection),
            })
            error.hidden = false
            status.textContent = result.state.rejection === "revision_conflict"
              ? "The session changed elsewhere. Its latest revision is loaded; review and try again."
              : "Review the live response and adjust your booking."
          } else {
            status.textContent = isContinuableCommitOutcome(result.state.commitOutcome)
              ? "Supplier confirmation is still pending. Check booking status again; this safely continues the same booking attempt."
              : `${readableCode(result.state.lastOutcome)}.`
          }
        } catch (caught) {
          error.textContent = caught instanceof Error ? caught.message : "Live booking is temporarily unavailable."
          error.hidden = false
          status.textContent = copy.nothingChanged
        } finally {
          inFlight = false
          root.removeAttribute("aria-busy")
        }
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault()
        if (journey) void run("create")
      })
      for (const control of root.querySelectorAll("[data-action]")) {
        if (!(control instanceof HTMLButtonElement) || control.type === "submit") continue
        control.addEventListener("click", () => void run(control.dataset.action))
      }
      document.addEventListener("voyant:departure-selected", (event) => {
        const departure = event instanceof CustomEvent ? event.detail?.departureSlotId : undefined
        const input = form.elements.namedItem("departureSlotId")
        if (typeof departure === "string" && input instanceof HTMLInputElement) {
          input.value = departure
          input.focus()
          if (status instanceof HTMLElement) status.textContent = copy.departureSelected
        }
      })
      root.addEventListener("voyant:itinerary-session-created", (event) => {
        if (!(event instanceof CustomEvent) || root.dataset.bookingMode !== "itinerary") return
        const outcome = event.detail?.outcome
        try {
          journey = createBookingJourney({
            endpoint: bookingEndpoint,
            checkoutEndpoint: root.dataset.checkoutEndpoint,
            initialOutcome: outcome,
            capability: event.detail?.bookingSessionCapability,
          })
          root.hidden = false
          render(journey.state())
          if (status instanceof HTMLElement) {
            status.textContent = copy.itineraryCreated
          }
        } catch (caught) {
          if (error instanceof HTMLElement) {
            error.textContent = caught instanceof Error
              ? caught.message
              : "The managed itinerary session was invalid."
            error.hidden = false
          }
        }
      })
    }
  }
</script>

<style>
  .booking-journey {
    background: var(--accent-wash);
    border: 1px solid var(--line);
    border-radius: var(--corner);
    padding: 1.5rem;
  }
  .eyebrow {
    color: var(--ink-subtle);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    margin: 0;
    text-transform: uppercase;
  }
  .booking-journey h2 {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0.65rem 0 0;
  }
  .intro {
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.65;
    margin: 0.75rem 0 0;
  }

  .fields {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.5rem;
  }
  .fields label {
    color: var(--ink-muted);
    display: grid;
    font-size: 0.8125rem;
    font-weight: 500;
    gap: 0.45rem;
  }
  .fields label span {
    color: var(--ink-subtle);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.5;
  }
  .fields .wide {
    grid-column: 1 / -1;
  }
  input {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--corner);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    min-height: 2.85rem;
    min-width: 0;
    padding: 0.6rem 0.75rem;
    transition: border-color 0.3s var(--ease-out-expo);
  }
  input:hover {
    border-color: color-mix(in oklab, var(--ink) 32%, transparent);
  }
  input:focus-visible {
    border-color: var(--accent);
    outline: 2px solid color-mix(in oklab, var(--accent) 32%, transparent);
    outline-offset: 1px;
  }

  fieldset {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  fieldset[hidden] {
    display: none;
  }
  fieldset label {
    align-items: center;
    display: flex;
    font-size: 0.875rem;
    gap: 0.45rem;
  }
  fieldset input {
    accent-color: var(--accent);
    min-height: auto;
  }
  legend {
    color: var(--ink-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    width: 100%;
  }

  .actions,
  .session-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  [hidden] {
    display: none !important;
  }

  button {
    align-items: center;
    background: var(--accent);
    border: 1px solid transparent;
    border-radius: var(--radius-pill, 999px);
    color: var(--accent-ink);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    min-height: 2.5rem;
    padding: 0 1.15rem;
    transition:
      background-color 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo);
  }
  button:hover:not(:disabled) {
    background: var(--accent-hover);
  }
  button.secondary {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }
  button.secondary:hover:not(:disabled) {
    background: transparent;
    border-color: color-mix(in oklab, var(--ink) 45%, transparent);
  }
  button.link {
    background: transparent;
    border: 0;
    color: var(--ink-muted);
    min-height: auto;
    padding-inline: 0;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  button.link:hover:not(:disabled) {
    background: transparent;
    color: var(--ink);
  }
  button.danger {
    color: #9f2929;
  }
  button:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }
  button:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--accent) 40%, transparent);
    outline-offset: 2px;
  }

  .status,
  .handoff {
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
    margin: 1.25rem 0 0;
  }
  .status:empty {
    display: none;
  }
  .handoff a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .error {
    border-inline-start: 2px solid #b42318;
    color: #b42318;
    font-size: 0.8125rem;
    line-height: 1.6;
    margin: 1.25rem 0 0;
    padding-inline-start: 0.75rem;
  }

  .live-state {
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
  }
  .live-state div {
    min-width: 0;
  }
  .live-state dt {
    color: var(--ink-subtle);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .live-state dd {
    font-size: 0.8125rem;
    margin: 0.3rem 0 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 34rem) {
    .fields {
      grid-template-columns: 1fr;
    }
    .fields .wide {
      grid-column: auto;
    }
  }
</style>
