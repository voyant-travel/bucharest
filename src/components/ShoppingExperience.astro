---
/**
 * Live shopping: search the whole journey, arrange it into one trip.
 *
 * Everything here queries live capabilities — a publication snapshot carries no
 * price and no availability, so nothing on this panel can be server-rendered
 * from it. What the reader sees before JavaScript runs is the form itself,
 * which is why the form is real markup rather than a mounting point.
 *
 * The hooks are a contract with `shopping-ui.mjs`: every `data-*` attribute,
 * every `name`, every `data-i18n` key and the class names on runtime-built
 * nodes (`result-card`, `trip-item`, …) are read by that module. Restyling is
 * not a reason to renegotiate any of them, so this file changes how the panel
 * looks and leaves what it *is* alone.
 *
 * Form controls are styled in a scoped block rather than with utilities on
 * thirty individual inputs: they all want the same treatment, and one rule that
 * says so is easier to keep honest than thirty copies of it.
 */
import { messagesFor } from "../lib/shopping.mjs"
import BookingJourney from "./BookingJourney.astro"

interface Props {
  locale: string
  searchEndpoint?: string
  tripsEndpoint?: string
  tripBookingEndpoint?: string
  bookingEndpoint?: string
  checkoutEndpoint?: string
  initialKind?: "indexed-inspiration" | "stay" | "flight" | "package" | "cruise"
  headingId?: string
  eyebrow?: string
  heading?: string
  introduction?: string
}

const {
  locale,
  searchEndpoint,
  tripsEndpoint,
  tripBookingEndpoint,
  bookingEndpoint,
  checkoutEndpoint,
  initialKind = "indexed-inspiration",
  headingId = "shopping-heading",
  eyebrow,
  heading,
  introduction,
} = Astro.props
const copy = messagesFor(locale)
---

<section
  class="shopping u-shell py-16 md:py-24"
  data-shopping
  data-locale={locale}
  data-search-endpoint={searchEndpoint}
  data-trips-endpoint={tripsEndpoint}
  data-trip-booking-endpoint={tripBookingEndpoint}
  aria-labelledby={headingId}
>
  <header class="shopping-intro max-w-[46rem]">
    <p class="u-eyebrow flex items-center gap-3 text-ink-subtle" data-i18n={eyebrow ? undefined : "shoppingEyebrow"}>
      <span class="h-px w-6 bg-current opacity-45" aria-hidden="true"></span>
      {eyebrow ?? copy.shoppingEyebrow}
    </p>
    <h2
      id={headingId}
      class="u-display mt-6 text-[2.25rem] sm:text-[2.75rem] md:text-[3.25rem]"
      data-i18n={heading ? undefined : "shoppingHeading"}
    >
      <Fragment set:html={heading ?? copy.shoppingHeading} />
    </h2>
    <p
      class="mt-6 text-[1.0625rem] leading-[1.65] text-ink-muted md:text-[1.125rem]"
      data-i18n={introduction ? undefined : "shoppingIntro"}
    >
      {introduction ?? copy.shoppingIntro}
    </p>
  </header>

  <div
    class="scope mt-12 flex flex-wrap items-end gap-x-8 gap-y-4 border-y border-line py-5"
    role="group"
    aria-label="Shopping preferences"
  >
    <label>
      <span data-i18n="language">{copy.language}</span>
      <select id="shopping-locale" name="shoppingLocale" data-shopping-locale aria-describedby="shopping-scope-status">
        <option value={locale}>{locale}</option>
      </select>
    </label>
    <label>
      <span data-i18n="currency">{copy.currency}</span>
      <select id="shopping-currency" name="shoppingCurrency" data-shopping-currency aria-describedby="shopping-scope-status" disabled>
        <option value="">—</option>
      </select>
    </label>
    <p id="shopping-scope-status" class="visually-hidden" data-scope-status aria-live="polite"></p>
  </div>

  <div class="workspace mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="search-panel lg:col-span-8">
      <form data-shopping-form class="grid gap-6">
        <label class="kind">
          <span data-i18n="productType">{copy.productType}</span>
          <select name="kind" data-shopping-kind>
            <option value="indexed-inspiration" data-i18n="explore" selected={initialKind === "indexed-inspiration"}>{copy.explore}</option>
            <option value="stay" data-i18n="stays" selected={initialKind === "stay"}>{copy.stays}</option>
            <option value="flight" data-i18n="flights" selected={initialKind === "flight"}>{copy.flights}</option>
            <option value="package" data-i18n="packages" selected={initialKind === "package"}>{copy.packages}</option>
            <option value="cruise" data-i18n="cruises" selected={initialKind === "cruise"}>{copy.cruises}</option>
          </select>
        </label>

        <fieldset data-intent="indexed-inspiration">
          <legend class="visually-hidden" data-i18n="explore">{copy.explore}</legend>
          <label class="wide">
            <span data-i18n="keywords">{copy.keywords}</span>
            <input name="query" type="search" autocomplete="off" />
          </label>
          <label class="wide">
            <span data-i18n="destination">{copy.destination}</span>
            <input name="inspirationDestination" autocomplete="address-level2" />
          </label>
          <label>
            <span data-i18n="fromDate">{copy.fromDate}</span>
            <input name="fromDate" type="date" />
          </label>
          <label>
            <span data-i18n="toDate">{copy.toDate}</span>
            <input name="toDate" type="date" />
          </label>
        </fieldset>

        <fieldset data-intent="stay" hidden disabled>
          <legend class="visually-hidden" data-i18n="stays">{copy.stays}</legend>
          <label class="wide">
            <span data-i18n="destination">{copy.destination}</span>
            <input name="stayDestination" autocomplete="address-level2" required />
          </label>
          <label>
            <span data-i18n="checkIn">{copy.checkIn}</span>
            <input name="checkIn" type="date" required />
          </label>
          <label>
            <span data-i18n="checkOut">{copy.checkOut}</span>
            <input name="checkOut" type="date" required />
          </label>
          <label>
            <span data-i18n="adults">{copy.adults}</span>
            <input name="stayAdults" type="number" min="1" max="20" value="2" required />
          </label>
        </fieldset>

        <fieldset data-intent="flight" hidden disabled>
          <legend class="visually-hidden" data-i18n="flights">{copy.flights}</legend>
          <label>
            <span data-i18n="origin">{copy.origin}</span>
            <input name="flightOrigin" minlength="3" maxlength="3" autocomplete="off" required />
          </label>
          <label>
            <span data-i18n="flightDestination">{copy.flightDestination}</span>
            <input name="flightDestination" minlength="3" maxlength="3" autocomplete="off" required />
          </label>
          <label>
            <span data-i18n="departureDate">{copy.departureDate}</span>
            <input name="departureDate" type="date" required />
          </label>
          <label>
            <span data-i18n="adults">{copy.adults}</span>
            <input name="flightAdults" type="number" min="1" max="20" value="1" required />
          </label>
          <label>
            <span data-i18n="cabin">{copy.cabin}</span>
            <select name="cabin">
              <option value="economy" data-i18n="economy">{copy.economy}</option>
              <option value="premium_economy" data-i18n="premium_economy">{copy.premium_economy}</option>
              <option value="business" data-i18n="business">{copy.business}</option>
              <option value="first" data-i18n="first">{copy.first}</option>
            </select>
          </label>
          <label class="check">
            <input name="directOnly" type="checkbox" />
            <span data-i18n="directOnly">{copy.directOnly}</span>
          </label>
        </fieldset>

        <fieldset data-intent="package" hidden disabled>
          <legend class="visually-hidden" data-i18n="packages">{copy.packages}</legend>
          <label>
            <span data-i18n="origin">{copy.origin}</span>
            <input name="packageOrigin" minlength="3" maxlength="3" autocomplete="off" required />
          </label>
          <label>
            <span data-i18n="destination">{copy.destination}</span>
            <input name="packageDestination" autocomplete="address-level2" required />
          </label>
          <label>
            <span data-i18n="fromDate">{copy.fromDate}</span>
            <input name="packageFrom" type="date" required />
          </label>
          <label>
            <span data-i18n="toDate">{copy.toDate}</span>
            <input name="packageTo" type="date" required />
          </label>
          <label>
            <span data-i18n="nightsMin">{copy.nightsMin}</span>
            <input name="nightsMin" type="number" min="1" value="3" required />
          </label>
          <label>
            <span data-i18n="nightsMax">{copy.nightsMax}</span>
            <input name="nightsMax" type="number" min="1" value="7" required />
          </label>
          <label>
            <span data-i18n="adults">{copy.adults}</span>
            <input name="packageAdults" type="number" min="1" max="20" value="2" required />
          </label>
        </fieldset>

        <fieldset data-intent="cruise" hidden disabled>
          <legend class="visually-hidden" data-i18n="cruises">{copy.cruises}</legend>
          <label class="wide">
            <span data-i18n="keywords">{copy.keywords}</span>
            <input name="cruiseQuery" type="search" autocomplete="off" />
          </label>
          <label>
            <span data-i18n="fromDate">{copy.fromDate}</span>
            <input name="cruiseFrom" type="date" />
          </label>
          <label>
            <span data-i18n="toDate">{copy.toDate}</span>
            <input name="cruiseTo" type="date" />
          </label>
          <label>
            <span data-i18n="adults">{copy.adults}</span>
            <input name="cruiseAdults" type="number" min="1" max="20" value="2" required />
          </label>
          <label>
            <span data-i18n="children">{copy.children}</span>
            <input name="cruiseChildren" type="number" min="0" max="20" value="0" />
          </label>
          <label class="wide">
            <span data-i18n="cruiseType">{copy.cruiseType}</span>
            <select name="cruiseType">
              <option value="" data-i18n="anyCruiseType">{copy.anyCruiseType}</option>
              <option value="ocean" data-i18n="oceanCruise">{copy.oceanCruise}</option>
              <option value="river" data-i18n="riverCruise">{copy.riverCruise}</option>
              <option value="expedition" data-i18n="expeditionCruise">{copy.expeditionCruise}</option>
              <option value="coastal" data-i18n="coastalCruise">{copy.coastalCruise}</option>
            </select>
          </label>
        </fieldset>

        <button type="submit" data-shopping-submit disabled={!searchEndpoint}>
          <span data-i18n="search">{copy.search}</span>
        </button>
      </form>

      <p class="status mt-5 text-[0.8125rem] text-ink-subtle" data-shopping-status role="status" aria-live="polite">
        {!searchEndpoint && copy.unavailable}
      </p>
      <section class="results" data-shopping-results hidden aria-labelledby="shopping-results-heading">
        <h3 id="shopping-results-heading" class="u-eyebrow text-ink-subtle" data-i18n="results">{copy.results}</h3>
        <div data-result-groups></div>
      </section>
    </div>

    <aside class="trip lg:col-span-4" aria-labelledby="shopping-trip-heading">
      <div class="rounded-card border border-line bg-surface p-6 lg:sticky lg:top-32">
        <h3 id="shopping-trip-heading" class="u-display-sm text-[1.375rem]" data-i18n="tripHeading">{copy.tripHeading}</h3>
        <p class="mt-3 text-[0.875rem] leading-relaxed text-ink-muted" data-i18n="tripIntro">{copy.tripIntro}</p>
        <p class="trip-status mt-4 text-[0.8125rem] text-ink-subtle empty:hidden" data-trip-status role="status" aria-live="polite"></p>
        <ol data-trip-items></ol>
        <p class="mt-4 text-[0.875rem] text-ink-subtle" data-trip-empty data-i18n="emptyTrip">{copy.emptyTrip}</p>
        <button type="button" class="mt-5" data-trip-book disabled={!tripBookingEndpoint || !bookingEndpoint}>
          <span data-i18n="bookItinerary">{copy.bookItinerary}</span>
        </button>
        {bookingEndpoint && (
          <BookingJourney
            mode="itinerary"
            locale={locale}
            bookingEndpoint={bookingEndpoint}
            checkoutEndpoint={checkoutEndpoint}
          />
        )}
      </div>
    </aside>
  </div>
</section>

<script>
  import { mountShopping } from "../lib/shopping-ui.mjs"

  for (const root of document.querySelectorAll("[data-shopping]")) {
    if (root instanceof HTMLElement) mountShopping(root)
  }
</script>

<style>
  /* Form controls. One rule, thirty inputs. */
  .shopping label {
    color: var(--ink-muted);
    display: grid;
    font-size: 0.8125rem;
    font-weight: 500;
    gap: 0.45rem;
    letter-spacing: 0.01em;
  }
  .shopping .scope label {
    min-width: 9rem;
  }
  .shopping fieldset {
    border: 0;
    display: grid;
    gap: 1rem 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }
  .shopping fieldset[hidden] {
    display: none;
  }
  .shopping .wide {
    grid-column: 1 / -1;
  }
  .shopping .check {
    align-items: center;
    display: flex;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .shopping input,
  .shopping select {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--corner);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    min-height: 3rem;
    padding: 0.65rem 0.85rem;
    transition: border-color 0.3s var(--ease-out-expo);
    width: 100%;
  }
  .shopping input:hover,
  .shopping select:hover {
    border-color: color-mix(in oklab, var(--ink) 32%, transparent);
  }
  .shopping input:focus-visible,
  .shopping select:focus-visible {
    border-color: var(--accent);
    outline: 2px solid color-mix(in oklab, var(--accent) 32%, transparent);
    outline-offset: 1px;
  }
  .shopping .check input {
    accent-color: var(--accent);
    min-height: auto;
    width: auto;
  }

  .shopping button {
    align-items: center;
    background: var(--accent);
    border: 1px solid transparent;
    border-radius: var(--radius-pill, 999px);
    color: var(--accent-ink);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    justify-self: start;
    min-height: 2.75rem;
    padding: 0 1.6rem;
    transition: background-color 0.3s var(--ease-out-expo);
  }
  .shopping button:hover:not(:disabled) {
    background: var(--accent-hover);
  }
  .shopping button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .shopping button:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--accent) 40%, transparent);
    outline-offset: 2px;
  }

  .shopping .results {
    margin-top: 3rem;
  }

  /*
   * Everything below is built by `shopping-ui.mjs` at runtime, so it carries no
   * scope hash and has to be addressed globally. The class names are that
   * module's, not this file's.
   */
  :global(.result-group) {
    margin-top: 2.5rem;
  }
  :global(.result-group > h4) {
    color: var(--ink-subtle);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    margin: 0 0 1.25rem;
    text-transform: uppercase;
  }
  :global(.result-grid) {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  :global(.result-card) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--corner);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 1.15rem;
  }
  :global(.result-card img) {
    aspect-ratio: 4 / 3;
    margin: -1.15rem -1.15rem 1.15rem;
    object-fit: cover;
    width: calc(100% + 2.3rem);
  }
  :global(.result-card h5) {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }
  :global(.result-card p) {
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0 0 0.9rem;
  }
  :global(.result-card .price) {
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    margin-top: auto;
    padding-top: 0.9rem;
  }
  :global(.result-card button) {
    margin-top: 0.9rem;
    width: 100%;
    justify-content: center;
  }

  :global(.trip ol) {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  :global(.trip-item) {
    border: 1px solid var(--line);
    border-radius: var(--corner);
    padding: 0.85rem;
  }
  :global(.trip-item p) {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0 0 0.6rem;
    text-transform: capitalize;
  }
  :global(.trip-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  :global(.trip-actions button) {
    background: transparent;
    border-color: var(--line);
    color: var(--ink-muted);
    font-size: 0.75rem;
    min-height: 2rem;
    padding: 0 0.75rem;
  }
  :global(.trip-actions button:hover:not(:disabled)) {
    background: transparent;
    border-color: color-mix(in oklab, var(--ink) 35%, transparent);
    color: var(--ink);
  }
  :global(.trip .booking-journey) {
    margin-top: 1.5rem;
  }

  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (max-width: 48rem) {
    .shopping fieldset {
      grid-template-columns: 1fr;
    }
    .shopping .wide {
      grid-column: auto;
    }
    .shopping .check {
      margin-top: 0;
    }
  }
</style>
