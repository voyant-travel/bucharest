---
/**
 * The cruise surfaces: the listing, a cruise, a ship, a sailing.
 *
 * Four context kinds share one component because they share one anatomy — a
 * lead, a row of facts, then the editorial sections a reader asks for in the
 * order they ask for them. Splitting them into four files would mean four
 * places to fix a heading.
 *
 * Everything here is editorial identity from the publication snapshot. Prices
 * and live availability are deliberately absent: the contract strips commercial
 * values from a snapshot, so the cruise index hands that job to the live search
 * rendered beneath it, and a sailing page says so rather than showing a stale
 * fare.
 */
import type {
  CruiseDetailContext,
  CruiseIndexContext,
  SailingDetailContext,
  ShipDetailContext,
} from "@voyant-travel/theme"
import JourneyCard from "~/components/cards/JourneyCard.astro"
import PlaceCard from "~/components/cards/PlaceCard.astro"
import PageLead from "~/components/primitives/PageLead.astro"
import Photo from "~/components/primitives/Photo.astro"
import { coverOf, dayPhotoOf, illustrated, placesOf } from "~/lib/catalog"
import { cn } from "~/lib/cn"
import { formatDate, formatDateRange } from "~/lib/dates"
import { counted, fill, messagesFor } from "~/lib/messages"
import { loadCruise } from "~/lib/product/adapter"
import { readSettings } from "~/lib/site"
import CabinGradeSelector from "~/components/islands/product/cruise/CabinGradeSelector"

interface Props {
  context:
    | CruiseIndexContext
    | CruiseDetailContext
    | ShipDetailContext
    | SailingDetailContext
}

const { context } = Astro.props
const locale = context.locale
const t = messagesFor(locale)

const cruise = context.kind === "cruiseDetail" ? context.cruise : undefined
const ship = context.kind === "shipDetail" ? context.ship : undefined
const sailing = context.kind === "sailingDetail" ? context.sailing : undefined

const heading = "u-display-sm text-[1.625rem] md:text-[2rem]"
const body = "u-shell pb-24 pt-14 md:pb-32 md:pt-20"

const cruiseCover = cruise ? coverOf(cruise) : undefined
const shipCover = ship ? coverOf(ship) : undefined
// A sailing could not carry a photograph before SDK 1.1.0, so this page opened
// on a blank canvas however good the cruise's photography was one level up.
const sailingCover = sailing ? coverOf(sailing) : undefined

/*
 * Cabin prices for this sailing. Fixture-backed like every other commercial
 * value in the theme, because the contract strips fares from a snapshot and
 * `cruise.pricing.v1` is what will fill this in production.
 *
 * `bookingUrl` is undefined on every cruise context by contract — the validator
 * classes it as live commercial state — so the selector's CTAs resolve to an
 * enquiry here. That is the intended behaviour, not a gap.
 */
const cruiseCommerce = loadCruise(sailing?.id ?? "", sailing?.cabinCategories ?? [])
const siteSettings = readSettings(context.settings)
const bookingUrl = siteSettings.bookingUrl

/*
 * The number to call when a cabin cannot be booked online — which on a cruise
 * page is always, since the contract forbids a booking URL here.
 *
 * `phone` is forbidden too: the validator classes it as personal information
 * that must not be frozen into an immutable cruise snapshot. The operator's own
 * call button survives that rule, though, so when they have configured one as a
 * `tel:` link it is both available and exactly the number they meant. Without
 * it the card says plainly that there is nothing to call, rather than offering
 * a link that goes nowhere.
 */
const callHref = siteSettings.secondaryCtaHref
const phone =
  siteSettings.phone ??
  (callHref?.startsWith("tel:") ? callHref.slice(4) : undefined)

/**
 * The calendar date a numbered day falls on.
 *
 * Day one is the departure date, so day N is N-1 days after it. Parsed as UTC
 * and advanced in UTC: a local-midnight parse of `2026-09-12` lands on the 11th
 * west of Greenwich, which would date every day of the sailing one short.
 *
 * Returns nothing when the sailing publishes no start date, because a day
 * without a real date is better shown as "Day 3" than as a date the theme
 * guessed.
 */
function dayDate(dayNumber: number): string | undefined {
  const startsOn = sailing?.departure?.startsOn
  if (!startsOn) return undefined
  const start = new Date(`${startsOn}T00:00:00Z`)
  if (Number.isNaN(start.getTime())) return undefined
  start.setUTCDate(start.getUTCDate() + Math.max(0, dayNumber - 1))
  return formatDate(locale, start.toISOString().slice(0, 10))
}
const ports = placesOf(cruise?.ports)

/*
 * Whether a list is worth showing as photography.
 *
 * A card grid reserves a picture-shaped box per item, which is right when the
 * operator has uploaded pictures and a row of empty grey rectangles when they
 * have not. Cabin categories and ship profiles are frequently text-only, so the
 * page asks the data which layout it can actually fill instead of committing to
 * one and hoping.
 */
const shipsAreIllustrated = (cruise?.ships ?? []).some((item) => coverOf(item))
const cabinsAreIllustrated = (ship?.cabinCategories ?? []).some((cabin) =>
  coverOf(cabin),
)

/** The listing, as cards. Counts stand in for the summary a cruise may not have. */
const cruises =
  context.kind === "cruiseIndex"
    ? context.cruises.map((item) => {
        const cover = coverOf(item)
        return {
          title: item.name,
          href: `/cruises/${encodeURIComponent(item.slug)}`,
          meta:
            item.shortDescription ??
            [
              counted(locale, t, "ships", item.ships.length),
              counted(locale, t, "sailings", item.sailings.length),
            ].join(" · "),
          image: cover?.src,
          imageAlt: cover?.alt,
        }
      })
    : []

const shipFacts = ship
  ? [
      ship.launchedYear
        ? { label: t.launched, value: String(ship.launchedYear) }
        : undefined,
      ship.deckCount ? { label: t.decks, value: String(ship.deckCount) } : undefined,
      ship.cabinCategories.length > 0
        ? {
            label: t.cabinCategories,
            value: String(ship.cabinCategories.length),
          }
        : undefined,
    ].filter((fact): fact is { label: string; value: string } => fact !== undefined)
  : []

const sailingFacts = sailing
  ? [
      {
        label: t.dates,
        value: formatDateRange(
          locale,
          sailing.departure.startsOn,
          sailing.departure.endsOn,
        ),
      },
      {
        label: t.length,
        value: counted(locale, t, "nights", sailing.departure.durationNights),
      },
      { label: t.embark, value: sailing.departure.embarkationPort.name },
      { label: t.disembark, value: sailing.departure.disembarkationPort.name },
    ]
  : []
---

{
  context.kind === "cruiseIndex" && (
    <div class="u-shell pb-16 pt-16 md:pt-24">
      <header class="max-w-[46rem]">
        <p class="u-eyebrow flex items-center gap-3 text-ink-subtle">
          <span class="h-px w-6 bg-current opacity-45" aria-hidden="true" />
          {t.cruises}
        </p>
        <h1 class="u-display mt-6 text-[2.5rem] sm:text-[3.25rem] md:text-[4rem]">
          {context.title}
        </h1>
        {context.seo.description && (
          <p class="mt-6 text-[1.0625rem] leading-[1.65] text-ink-muted md:text-[1.125rem]">
            {context.seo.description}
          </p>
        )}
      </header>

      {cruises.length === 0 ? (
        <p class="u-serif-body mt-12 max-w-[38rem] text-[1.125rem] text-ink-subtle">
          {t.noCruisesPublished}
        </p>
      ) : (
        <ul class="mt-14 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {cruises.map((item) => (
            <li>
              <JourneyCard
                image={item.image}
                imageAlt={item.imageAlt}
                title={item.title}
                meta={item.meta}
                href={item.href}
                ratio="aspect-[3/4]"
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
              />
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

{
  cruise && (
    <article>
      <PageLead
        title={cruise.name}
        eyebrow={t.cruise}
        backHref="/cruises"
        backLabel={t.backToCruises}
        image={cruiseCover?.src}
        imageAlt={cruiseCover?.alt}
      />

      <div class={body}>
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-8">
            {cruise.shortDescription && (
              <p class="u-serif-body text-[1.25rem] leading-[1.55] text-ink md:text-[1.5rem]">
                {cruise.shortDescription}
              </p>
            )}

            {cruise.descriptionHtml && (
              <section class="mt-12">
                <h2 class={heading}>{t.overview}</h2>
                <div class="prose mt-6" set:html={cruise.descriptionHtml} />
              </section>
            )}

            {cruise.sailings.length > 0 && (
              <section class="mt-16">
                <h2 class={heading}>{t.publishedSailings}</h2>
                {
                  /*
                   * Sailings are rows rather than cards: a reader scanning for a
                   * date wants the dates in one column, which a grid of tiles
                   * does not give them.
                   */
                }
                <ul class="mt-8 border-t border-line">
                  {cruise.sailings.map((item) => (
                    <li class="border-b border-line">
                      <a
                        href={`/sailings/${encodeURIComponent(item.slug)}`}
                        class="group grid gap-2 py-6 transition-opacity duration-300 hover:opacity-70 md:grid-cols-12 md:items-baseline md:gap-8"
                      >
                        <p class="u-serif-body md:col-span-4 md:text-[1.0625rem]">
                          {formatDateRange(
                            locale,
                            item.departure.startsOn,
                            item.departure.endsOn,
                          )}
                        </p>
                        <p class="u-display-sm text-[1.125rem] md:col-span-5 md:text-[1.25rem]">
                          {item.name}
                        </p>
                        <p class="text-[0.8125rem] text-ink-muted md:col-span-3 md:text-right">
                          {counted(locale, t, "nights", item.departure.durationNights)}
                          <span class="mx-1.5 opacity-40">·</span>
                          {item.departure.embarkationPort.name}
                        </p>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {cruise.ports.length > 0 && (
              <section class="mt-16">
                <h2 class={heading}>{t.whereYouGo}</h2>
                {illustrated(ports) ? (
                  <ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
                    {ports.map((port) => (
                      <li>
                        <PlaceCard
                          image={port.photo?.src}
                          imageAlt={port.photo?.alt}
                          title={port.name}
                          ratio="aspect-[4/5]"
                          sizes="(min-width: 768px) 26vw, 46vw"
                        />
                      </li>
                    ))}
                  </ul>
                ) : (
                  <ul class="mt-8 flex flex-wrap gap-2.5">
                    {ports.map((port) => (
                      <li class="rounded-pill border border-line px-5 py-2.5 text-[0.875rem] text-ink-muted">
                        {port.name}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            )}
          </div>

          {cruise.ships.length > 0 && (
            <aside class="lg:col-span-4">
              <div class="lg:sticky lg:top-32">
                <h2 class="u-eyebrow text-ink-subtle">{t.ships}</h2>
                {shipsAreIllustrated ? (
                  <ul class="mt-6 grid gap-8 sm:grid-cols-2 lg:grid-cols-1">
                    {cruise.ships.map((item) => {
                      const cover = coverOf(item)
                      return (
                        <li>
                          <JourneyCard
                            image={cover?.src}
                            imageAlt={cover?.alt}
                            title={item.name}
                            region={item.cruiseLine}
                            meta={counted(
                              locale,
                              t,
                              "cabins",
                              item.cabinCategories.length,
                            )}
                            href={`/ships/${encodeURIComponent(item.slug)}`}
                            ratio="aspect-[16/10]"
                            sizes="(min-width: 1024px) 24vw, (min-width: 640px) 46vw, 92vw"
                          />
                        </li>
                      )
                    })}
                  </ul>
                ) : (
                  <ul class="mt-6 border-t border-line">
                    {cruise.ships.map((item) => (
                      <li class="border-b border-line">
                        <a
                          href={`/ships/${encodeURIComponent(item.slug)}`}
                          class="block py-5 transition-opacity duration-300 hover:opacity-65"
                        >
                          {item.cruiseLine && (
                            <p class="u-eyebrow text-ink-subtle">{item.cruiseLine}</p>
                          )}
                          <p class="u-display-sm mt-2 text-[1.1875rem]">{item.name}</p>
                          <p class="mt-1.5 text-[0.8125rem] text-ink-muted">
                            {counted(locale, t, "cabins", item.cabinCategories.length)}
                          </p>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </aside>
          )}
        </div>
      </div>
    </article>
  )
}

{
  ship && (
    <article>
      <PageLead
        title={ship.name}
        eyebrow={ship.cruiseLine ?? t.ship}
        backHref="/cruises"
        backLabel={t.browseCruises}
        image={shipCover?.src}
        imageAlt={shipCover?.alt}
      />

      <div class={body}>
        <div class="max-w-[52rem]">
          {shipFacts.length > 0 && (
            <dl class="grid grid-cols-2 gap-x-6 gap-y-7 border-y border-line py-8 sm:grid-cols-3">
              {shipFacts.map((fact) => (
                <div>
                  <dt class="u-eyebrow text-ink-subtle">{fact.label}</dt>
                  <dd class="u-serif-body mt-2.5 text-[1.0625rem]">{fact.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {ship.descriptionHtml && (
            <section class="mt-14">
              <h2 class={heading}>{t.overview}</h2>
              <div class="prose mt-6" set:html={ship.descriptionHtml} />
            </section>
          )}
        </div>

        <section class="mt-16">
          <h2 class={heading}>{t.cabinCategories}</h2>
          {ship.cabinCategories.length === 0 ? (
            <p class="mt-6 text-[0.9375rem] text-ink-subtle">{t.cabinDetailsSoon}</p>
          ) : cabinsAreIllustrated ? (
            <ul class="mt-8 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
              {ship.cabinCategories.map((cabin) => {
                const cover = coverOf(cabin)
                return (
                  <li>
                    <JourneyCard
                      image={cover?.src}
                      imageAlt={cover?.alt}
                      title={cabin.name}
                      region={cabin.deckNames.join(" · ") || undefined}
                      meta={
                        cabin.maxOccupancy
                          ? counted(locale, t, "guests", cabin.maxOccupancy)
                          : undefined
                      }
                      ratio="aspect-[4/3]"
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                    />
                  </li>
                )
              })}
            </ul>
          ) : (
            <ul class="mt-8 max-w-[52rem] border-t border-line">
              {ship.cabinCategories.map((cabin) => (
                <li class="grid gap-2 border-b border-line py-5 md:grid-cols-12 md:items-baseline md:gap-8">
                  <p class="u-display-sm text-[1.1875rem] md:col-span-5">
                    {cabin.name}
                  </p>
                  {cabin.deckNames.length > 0 && (
                    <p class="text-[0.8125rem] text-ink-muted md:col-span-4">
                      {cabin.deckNames.join(" · ")}
                    </p>
                  )}
                  {cabin.maxOccupancy && (
                    <p class="text-[0.8125rem] text-ink-subtle md:col-span-3 md:text-right">
                      {counted(locale, t, "guests", cabin.maxOccupancy)}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    </article>
  )
}

{
  sailing && (
    <article>
      <PageLead
        title={sailing.name}
        eyebrow={t.sailing}
        backHref="/cruises"
        backLabel={t.backToCruises}
        image={sailingCover?.src}
        imageAlt={sailingCover?.alt}
      />

      <div class={body}>
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-8">
            <dl class="grid grid-cols-2 gap-x-6 gap-y-7 border-y border-line py-8 sm:grid-cols-4">
              {sailingFacts.map((fact) => (
                <div>
                  <dt class="u-eyebrow text-ink-subtle">{fact.label}</dt>
                  <dd class="u-serif-body mt-2.5 text-[1.0625rem] leading-snug">
                    {fact.value}
                  </dd>
                </div>
              ))}
            </dl>

            <section class="mt-14">
              <h2 class={heading}>{sailing.itinerary.name}</h2>
              {
                /*
                 * A sea day is not a missing day. It gets the same row as a port
                 * call with its own label, so the rhythm of the crossing reads
                 * instead of looking like a gap in the data.
                 */
              }
              <ol class="mt-8 border-t border-line">
                {sailing.itinerary.days.map((day, index) => (
                  <li
                    class={cn(
                      "grid gap-3 border-b border-line md:grid-cols-12 md:gap-8",
                      /*
                       * A sea day is shorter and quieter than a port call. The
                       * label alone is not enough: a reader scanning a
                       * seven-night sailing wants to see at a glance how much of
                       * it is spent moving, and rows of identical weight hide
                       * exactly that. The reduced height is the information.
                       */
                      day.atSea ? "py-4 opacity-70" : "py-7",
                    )}
                  >
                    <div class="md:col-span-3">
                      <p class="u-eyebrow text-accent">
                        {fill(t.dayNumber, { count: day.dayNumber })}
                      </p>
                      {
                        /*
                         * The calendar date, resolved from the departure rather
                         * than published per day — the contract carries only a
                         * day number, and "Ziua 3" on a page that already knows
                         * the sailing date is asking the reader to do the
                         * arithmetic themselves.
                         */
                      }
                      {dayDate(day.dayNumber) && (
                        <p class="mt-1.5 text-[0.8125rem] text-ink-muted">
                          {dayDate(day.dayNumber)}
                        </p>
                      )}
                      {(index === 0 || index === sailing.itinerary.days.length - 1) && (
                        <p class="u-eyebrow mt-2 inline-flex rounded-pill border border-line px-2.5 py-1 text-ink-subtle">
                          {index === 0 ? t.embark : t.disembark}
                        </p>
                      )}
                      {day.atSea ? (
                        <p class="mt-2 text-[0.8125rem] text-ink-subtle">{t.atSea}</p>
                      ) : (
                        day.ports.length > 0 && (
                          <p class="mt-2 text-[0.8125rem] text-ink-subtle">
                            {day.ports.map((port) => port.name).join(" · ")}
                          </p>
                        )
                      )}
                    </div>
                    <div class="md:col-span-9">
                      <h3 class="u-display-sm text-[1.25rem] md:text-[1.375rem]">
                        {day.title}
                      </h3>
                      {day.descriptionHtml && (
                        <div class="prose mt-3 text-[0.9375rem]" set:html={day.descriptionHtml} />
                      )}
                      {dayPhotoOf(day) && (
                        <Photo
                          src={dayPhotoOf(day)!.src}
                          alt={dayPhotoOf(day)!.alt}
                          ratio="aspect-[16/9]"
                          class="mt-5 rounded-card"
                          sizes="(min-width: 1024px) 46vw, 92vw"
                        />
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </section>

            {
              /*
               * The decision the sailing page exists to support. A cruise is
               * chosen twice — a date, then a cabin — and this is the second
               * one, so it gets the priced, comparable treatment rather than
               * the bare list of names it had before.
               *
               * `client:visible` because it sits well below the fold on every
               * screen and is the heaviest thing on the page.
               */
              sailing.cabinCategories.length > 0 && (
                <section class="mt-16">
                  <h2 class={heading}>{t.cabinCategories}</h2>
                  <div class="mt-8">
                    <CabinGradeSelector
                      client:visible
                      grades={cruiseCommerce.grades}
                      currency={cruiseCommerce.currency}
                      nights={sailing.departure?.durationNights ?? 0}
                      portTax={cruiseCommerce.portTax}
                      serviceChargePerDay={cruiseCommerce.serviceChargePerDay}
                      bookingBase={bookingUrl}
                      productId={sailing.id}
                      productSlug={sailing.slug}
                      phone={phone}
                      locale={context.locale}
                    />
                  </div>
                </section>
              )
            }
          </div>

          <aside class="lg:col-span-4">
            <div class="lg:sticky lg:top-32">
              {
                /*
                 * Nothing commercial is stored in this page, so the panel that
                 * would carry a price carries the reason it does not, and points
                 * at the live search that can.
                 */
              }
              <div class="rounded-card border border-line bg-accent-wash p-6 md:p-7">
                <p class="u-eyebrow text-ink-subtle">{t.liveSelling}</p>
                <p class="u-serif-body mt-4 text-[1.0625rem] leading-[1.6]">
                  {formatDate(locale, sailing.departure.startsOn)}
                </p>
                <p class="mt-4 text-[0.875rem] leading-relaxed text-ink-muted">
                  {t.cruiseLiveNote}
                </p>
                <a
                  href="/cruises"
                  class="mt-6 inline-flex h-11 items-center rounded-pill bg-accent px-6 text-[0.875rem] font-medium text-accent-ink transition-colors duration-300 hover:bg-accent-hover"
                >
                  {t.findLiveSailing}
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </article>
  )
}
