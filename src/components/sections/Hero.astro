---
/**
 * The lead story.
 *
 * Every setting and block id this section shipped with is preserved, because
 * an id is the handle an operator's published page is stored against — renaming
 * one silently empties that section on every live site. What changed is the
 * presentation: with a photograph it becomes a full-bleed cinematic frame, and
 * without one a type-led editorial opening rather than a smaller version of
 * the same thing.
 */
import Photo from "~/components/primitives/Photo.astro"
import { cn } from "~/lib/cn"
import {
  attributeSetting,
  choiceSetting,
  imageSetting,
  linkSetting,
  numberSetting,
  visibleSetting,
  type SectionInstance,
} from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings

const eyebrow = visibleSetting(settings, "eyebrow")
const heading = visibleSetting(settings, "heading")
const body = visibleSetting(settings, "body")
const image = imageSetting(settings, "image")
const imageAlt = attributeSetting(settings, "image-alt")
const alignment = choiceSetting(settings, "alignment", ["left", "center"], "left")
const colorScheme = choiceSetting(settings, "color-scheme", ["light", "dark"], "light")
const height = numberSetting(settings, "height", 360, 720, 520)

const links = section.data.blocks
  .filter((block) => block.type === "link")
  .map((block) => ({
    label: visibleSetting(block.settings, "label"),
    href: linkSetting(block.settings, "page"),
    style: choiceSetting(block.settings, "style", ["solid", "outline"], "solid"),
  }))
  .filter((link) => link.label && link.href)

const centred = alignment === "center"
/** Staggered entrance. One orchestrated reveal beats six unrelated ones. */
const step = (index: number) => `animation-delay:${90 * index}ms`

const buttonBase =
  "inline-flex h-13 w-full items-center justify-center gap-2.5 rounded-pill px-8 text-[0.9375rem] font-medium transition-colors duration-300 sm:w-auto"
---

{
  image ? (
    <section class="relative isolate">
      {
        /*
         * The authored height is a floor rather than the height. An operator
         * who leaves it at 520 still gets a hero that fills the window, which
         * is what a full-bleed photograph is for; one who raises it gets more.
         */
      }
      <div
        class="u-frame u-scrim-hero u-scrim-top relative flex w-full items-end"
        style={`min-height:max(${height}px, 86svh)`}
      >
        <Photo
          src={image}
          alt={imageAlt}
          class="absolute inset-0 [&>img]:transition-none"
          priority
          sizes="100vw"
          decorative={Boolean(heading)}
        />

        <div class="u-shell relative z-[2] w-full pb-12 pt-28 md:pb-16 md:pt-32">
          <div class={cn("max-w-[54rem]", centred && "mx-auto text-center")}>
            {eyebrow && (
              <p
                class={cn(
                  "u-eyebrow flex animate-fade items-center gap-3 text-white/90 [text-shadow:0_1px_10px_rgb(0_0_0/0.55)]",
                  centred && "justify-center",
                )}
                style={step(0)}
              >
                <span class="h-px w-7 bg-current opacity-60" aria-hidden="true" />
                {eyebrow}
              </p>
            )}
            {heading && (
              <h1
                class="u-display mt-6 animate-rise text-[2.75rem] text-white drop-shadow-[0_2px_28px_rgba(0,0,0,0.35)] sm:text-[3.5rem] md:text-[4.5rem] lg:text-[5.25rem]"
                style={step(1)}
                set:html={heading}
              />
            )}
            {body && (
              <div
                class={cn(
                  "prose mt-5 max-w-[34rem] animate-rise [--ink-muted:rgb(255_255_255/0.9)] [&_a]:text-white",
                  centred && "mx-auto",
                )}
                style={step(2)}
                set:html={body}
              />
            )}
            {links.length > 0 && (
              <div
                class={cn(
                  "mt-7 flex animate-rise flex-wrap items-center gap-3",
                  centred && "justify-center",
                )}
                style={step(3)}
              >
                {links.map((link) => (
                  <a
                    href={link.href}
                    class={cn(
                      buttonBase,
                      link.style === "solid"
                        ? "bg-accent text-accent-ink hover:bg-accent-hover"
                        : "border border-white/40 text-white backdrop-blur-[2px] hover:border-white/60 hover:bg-white/15",
                    )}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section
      class={cn(
        "relative flex items-center",
        colorScheme === "dark" ? "bg-accent text-accent-ink" : "bg-canvas text-ink",
      )}
      style={`min-height:${Math.round(height * 0.72)}px`}
    >
      <div class="u-shell w-full py-20 md:py-28">
        <div class={cn("max-w-[58rem]", centred && "mx-auto text-center")}>
          {eyebrow && (
            <p
              class={cn(
                "u-eyebrow flex animate-fade items-center gap-3",
                colorScheme === "dark" ? "opacity-75" : "text-ink-subtle",
                centred && "justify-center",
              )}
              style={step(0)}
            >
              <span class="h-px w-7 bg-current opacity-50" aria-hidden="true" />
              {eyebrow}
            </p>
          )}
          {heading && (
            <h1
              class="u-display mt-7 animate-rise text-[2.75rem] sm:text-[3.75rem] lg:text-[4.75rem]"
              style={step(1)}
              set:html={heading}
            />
          )}
          {body && (
            <div
              class={cn(
                "prose mt-7 max-w-[38rem] animate-rise",
                colorScheme === "dark" &&
                  "[--ink-muted:color-mix(in_oklab,var(--accent-ink)_78%,transparent)]",
                centred && "mx-auto",
              )}
              style={step(2)}
              set:html={body}
            />
          )}
          {links.length > 0 && (
            <div
              class={cn(
                "mt-9 flex animate-rise flex-wrap items-center gap-3",
                centred && "justify-center",
              )}
              style={step(3)}
            >
              {links.map((link) => (
                <a
                  href={link.href}
                  class={cn(
                    buttonBase,
                    link.style === "solid"
                      ? colorScheme === "dark"
                        ? "bg-[var(--accent-ink)] text-[var(--accent)] hover:opacity-90"
                        : "bg-accent text-accent-ink hover:bg-accent-hover"
                      : "border border-current/30 hover:border-current/70",
                  )}
                >
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
