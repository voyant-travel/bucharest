---
/**
 * A compact message and one destination.
 *
 * Settings are unchanged, `background` included. The operator's color is a
 * real choice, so it still drives the panel — but the foreground is now
 * derived from it rather than assumed dark, which is what stops a dark
 * background arriving with black type on it.
 */
import Band from "~/components/primitives/Band.astro"
import {
  colorSetting,
  linkSetting,
  visibleSetting,
  type SectionInstance,
} from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const heading = visibleSetting(settings, "heading")
const body = visibleSetting(settings, "body")
const label = visibleSetting(settings, "label")
const href = linkSetting(settings, "page")
const background = colorSetting(settings, "background", "#e7efe9")

/**
 * Relative luminance of the authored background, so the type on top of it is
 * chosen rather than hoped for. sRGB coefficients, no gamma correction: the
 * decision is a single light/dark threshold, and the extra precision would not
 * move it.
 */
function isDark(hex: string): boolean {
  const value = hex.slice(1)
  const full =
    value.length === 3
      ? value
          .split("")
          .map((char) => char + char)
          .join("")
      : value
  const r = parseInt(full.slice(0, 2), 16)
  const g = parseInt(full.slice(2, 4), 16)
  const b = parseInt(full.slice(4, 6), 16)
  return (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.55
}

const dark = isDark(background)
---

{
  heading && (
    <Band tone="canvas" spacing="regular">
      <div
        class:list={["callout-panel rounded-card px-7 py-14 md:px-14 md:py-20", { dark }]}
        style={`background:${background}`}
      >
        <div class="grid items-end gap-8 md:grid-cols-12 md:gap-12">
          <div class="md:col-span-8">
            <h2
              class="u-display text-[2rem] md:text-[2.875rem] lg:text-[3.25rem]"
              set:html={heading}
            />
            {body && <div class="prose mt-6 max-w-[38rem]" set:html={body} />}
          </div>

          {label && href && (
            <div class="md:col-span-4 md:justify-self-end">
              <a
                href={href}
                class="group inline-flex h-13 items-center justify-center gap-2.5 whitespace-nowrap rounded-pill px-8 text-[0.9375rem] font-medium transition-colors duration-300"
              >
                {label}
                <svg
                  class="h-3 w-3 shrink-0 transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:translate-x-1"
                  viewBox="0 0 12 12"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M1 6h9M6.5 2 10.5 6l-4 4"
                    stroke="currentColor"
                    stroke-width="1.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          )}
        </div>
      </div>
    </Band>
  )
}

<style>
  /* The panel color is authored, so its foreground is resolved here rather
     than with utilities — a Tailwind class cannot branch on a runtime hex. */
  .callout-panel {
    color: #14201b;
  }
  .callout-panel :global(.prose) {
    --ink-muted: color-mix(in oklab, #14201b 72%, transparent);
  }
  .callout-panel a {
    background: #14201b;
    color: #fbfaf7;
  }
  .callout-panel a:hover {
    background: color-mix(in oklab, #14201b 82%, white);
  }
  .callout-panel.dark {
    color: #f6f4ee;
  }
  .callout-panel.dark :global(.prose) {
    --ink-muted: color-mix(in oklab, #f6f4ee 78%, transparent);
  }
  .callout-panel.dark a {
    background: #f6f4ee;
    color: #14201b;
  }
  .callout-panel.dark a:hover {
    background: color-mix(in oklab, #f6f4ee 88%, black);
  }
</style>
