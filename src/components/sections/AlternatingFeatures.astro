---
import Band from "~/components/primitives/Band.astro"
import Heading from "~/components/primitives/Heading.astro"
import Photo from "~/components/primitives/Photo.astro"
import { cn } from "~/lib/cn"
import { frame } from "~/lib/presentation"
import {
  attributeSetting,
  choiceSetting,
  imageSetting,
  linkSetting,
  visibleSetting,
  type SectionInstance,
} from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const { tone, spacing } = frame(settings)
const layout = choiceSetting(settings, "layout", ["timeline", "zigzag"], "timeline")

const features = section.data.blocks
  .filter((block) => block.type === "feature")
  .map((block) => ({
    title: visibleSetting(block.settings, "title"),
    label: visibleSetting(block.settings, "label"),
    description: visibleSetting(block.settings, "description"),
    image: imageSetting(block.settings, "image"),
    imageAlt: attributeSetting(block.settings, "image-alt"),
    href: linkSetting(block.settings, "page"),
  }))
  .filter((feature) => feature.title || feature.description || feature.image)
---

{
  features.length > 0 && (
    <Band tone={tone} spacing={spacing}>
      <Heading
        eyebrow={visibleSetting(settings, "eyebrow")}
        heading={visibleSetting(settings, "heading")}
        lede={visibleSetting(settings, "introduction")}
        headingHtml
        align="center"
        class="mb-16 md:mb-24"
      />

      <div class="relative">
        {
          /*
           * The rule is decorative and drawn only where the alternation is
           * visible. On a phone every item is in one column, so a centred rule
           * would run through the middle of the photographs.
           */
        }
        {layout === "timeline" && (
          <div
            class="absolute inset-y-0 left-1/2 hidden w-px -translate-x-1/2 bg-line md:block"
            aria-hidden="true"
          />
        )}

        <div class="flex flex-col gap-14 md:gap-4">
          {features.map((feature, index) => {
            const flipped = index % 2 === 1
            const Wrapper = feature.href ? "a" : "div"
            return (
              <Wrapper
                href={feature.href}
                class={cn(
                  "group relative grid items-center gap-6 md:grid-cols-2 md:gap-16",
                  layout === "timeline" ? "md:py-10" : "md:py-6",
                )}
              >
                {layout === "timeline" && (
                  <span
                    class="absolute left-1/2 top-1/2 hidden h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-pill bg-accent ring-4 ring-[var(--canvas)] md:block"
                    aria-hidden="true"
                  />
                )}

                <div class={cn(flipped && "md:order-2")}>
                  {feature.image && (
                    <Photo
                      src={feature.image}
                      alt={feature.imageAlt}
                      ratio="aspect-[16/11]"
                      class="rounded-card"
                      sizes="(min-width: 768px) 42vw, 100vw"
                    />
                  )}
                </div>

                <div
                  class={cn(
                    "md:max-w-[26rem]",
                    flipped ? "md:order-1 md:justify-self-end md:text-right" : "",
                  )}
                >
                  {feature.label && <p class="u-eyebrow text-ink-subtle">{feature.label}</p>}
                  {feature.title && (
                    <h3 class="u-display-sm mt-3 text-[1.5rem] md:text-[1.875rem]">
                      {feature.title}
                    </h3>
                  )}
                  {feature.description && (
                    <p class="mt-4 text-[0.9375rem] leading-[1.75] text-ink-muted">
                      {feature.description}
                    </p>
                  )}
                </div>
              </Wrapper>
            )
          })}
        </div>
      </div>
    </Band>
  )
}
