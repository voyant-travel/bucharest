---
import Band from "~/components/primitives/Band.astro"
import Heading from "~/components/primitives/Heading.astro"
import { cn } from "~/lib/cn"
import { frame } from "~/lib/presentation"
import { choiceSetting, visibleSetting, type SectionInstance } from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const { tone, spacing } = frame(settings)
const layout = choiceSetting(settings, "layout", ["bordered", "row", "stacked"], "bordered")

const stats = section.data.blocks
  .filter((block) => block.type === "stat")
  .map((block) => ({
    value: visibleSetting(block.settings, "value"),
    label: visibleSetting(block.settings, "label"),
  }))
  .filter((stat) => stat.value || stat.label)

const headingProps = {
  eyebrow: visibleSetting(settings, "eyebrow"),
  heading: visibleSetting(settings, "heading"),
  lede: visibleSetting(settings, "introduction"),
}
const hasHeading = Boolean(headingProps.eyebrow || headingProps.heading || headingProps.lede)

const columns = ["", "md:grid-cols-1", "md:grid-cols-2", "md:grid-cols-3", "md:grid-cols-4"][
  Math.min(stats.length, 4)
]
---

{
  stats.length > 0 && (
    <Band tone={tone} spacing={spacing}>
      <div class={cn(layout === "stacked" && "grid gap-12 md:grid-cols-12 md:gap-16")}>
        {hasHeading && (
          <div class={cn(layout === "stacked" ? "md:col-span-5" : "mb-12")}>
            <Heading {...headingProps} headingHtml size="sm" />
          </div>
        )}

        <dl
          class={cn(
            "grid grid-cols-2 gap-x-8 gap-y-10",
            layout === "stacked" ? "md:col-span-7 md:grid-cols-2" : columns,
            layout === "bordered" &&
              "gap-0 border-t border-line [&>div]:border-b [&>div]:border-line [&>div]:py-8 md:border-t-0 md:[&>div]:border-b-0 md:[&>div]:border-l md:[&>div]:px-8 md:[&>div]:py-0 md:[&>div:first-child]:border-l-0 md:[&>div:first-child]:pl-0",
          )}
        >
          {stats.map((stat) => (
            <div>
              {stat.value && (
                <dd class="u-display text-[2.75rem] leading-none md:text-[3.5rem]">{stat.value}</dd>
              )}
              {stat.label && (
                <dt class="mt-3 text-[0.875rem] leading-snug text-ink-muted">{stat.label}</dt>
              )}
            </div>
          ))}
        </dl>
      </div>
    </Band>
  )
}
