---
import Band from "~/components/primitives/Band.astro"
import Heading from "~/components/primitives/Heading.astro"
import { cn } from "~/lib/cn"
import { frame } from "~/lib/presentation"
import { choiceSetting, visibleSetting, type SectionInstance } from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const { tone, spacing } = frame(settings)
const layout = choiceSetting(settings, "layout", ["side-heading", "single"], "side-heading")

const questions = section.data.blocks
  .filter((block) => block.type === "question")
  .map((block) => ({
    question: visibleSetting(block.settings, "question"),
    answer: visibleSetting(block.settings, "answer"),
  }))
  .filter((entry) => entry.question)

/**
 * `details` rather than an accordion island.
 *
 * The disclosure widget is native, keyboard-operable, and open in print and in
 * find-in-page — all of which a scripted accordion has to reimplement and
 * usually gets wrong. The shared `name` makes the group exclusive where the
 * browser supports it and leaves each panel independently openable where it
 * does not, which is a fine outcome either way.
 */
const groupName = `faq-${section.data.id.replace(/[^a-zA-Z0-9_-]/g, "-")}`
---

{
  questions.length > 0 && (
    <Band tone={tone} spacing={spacing}>
      <div class={cn(layout === "side-heading" && "grid gap-10 md:grid-cols-12 md:gap-16")}>
        <div class={cn(layout === "side-heading" ? "md:col-span-5" : "mb-12")}>
          <Heading
            eyebrow={visibleSetting(settings, "eyebrow")}
            heading={visibleSetting(settings, "heading")}
            lede={visibleSetting(settings, "introduction")}
            headingHtml
            class={cn("mb-0", layout === "side-heading" && "md:sticky md:top-28")}
          />
        </div>

        <div class={cn(layout === "side-heading" && "md:col-span-7")}>
          <div class="border-t border-line">
            {questions.map((entry) => (
              <details name={groupName} class="group border-b border-line">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                  <span class="u-serif-body text-[1.0625rem] leading-snug md:text-[1.1875rem]">
                    {entry.question}
                  </span>
                  <span class="relative mt-1.5 h-3.5 w-3.5 shrink-0 text-ink-subtle" aria-hidden="true">
                    <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current" />
                    <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current transition-transform duration-400 ease-[var(--ease-out-expo)] group-open:scale-y-0" />
                  </span>
                </summary>
                {entry.answer && <div class="prose pb-6 pr-10" set:html={entry.answer} />}
              </details>
            ))}
          </div>
        </div>
      </div>
    </Band>
  )
}
