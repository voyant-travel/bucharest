---
import { cn } from "~/lib/cn"
import { toneClass, TONES } from "~/lib/presentation"
import { choiceSetting, type SectionInstance } from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const style = choiceSetting(settings, "style", ["rule", "blank", "mark"], "rule")
const size = choiceSetting(settings, "size", ["small", "medium", "large"], "medium")
const tone = choiceSetting(settings, "tone", TONES, "canvas")

const pad = { small: "py-8", medium: "py-16", large: "py-28 md:py-36" }[size]
---

<div class={cn(toneClass(tone), pad)} aria-hidden="true">
  <div class="u-shell">
    {style === "rule" && <hr class="border-0 border-t border-line" />}
    {
      style === "mark" && (
        <div class="flex items-center justify-center gap-4 text-ink-subtle">
          <span class="h-px w-16 bg-line" />
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1">
            <path d="M6 1 7.4 4.6 11 6 7.4 7.4 6 11 4.6 7.4 1 6l3.6-1.4L6 1Z" />
          </svg>
          <span class="h-px w-16 bg-line" />
        </div>
      )
    }
  </div>
</div>
