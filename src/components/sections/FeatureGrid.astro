---
/**
 * A group of short, linked highlights.
 *
 * Settings and block ids are unchanged. `columns` still drives the grid and
 * `show-dividers` still decides whether the cards are separated by rules —
 * but a divided grid is now drawn as hairline-separated columns rather than
 * bordered boxes, which is what makes a row of three read as one band.
 */
import Photo from "~/components/primitives/Photo.astro"
import Band from "~/components/primitives/Band.astro"
import Heading from "~/components/primitives/Heading.astro"
import { cn } from "~/lib/cn"
import { frame } from "~/lib/presentation"
import {
  attributeSetting,
  booleanSetting,
  imageSetting,
  linkSetting,
  numberSetting,
  visibleSetting,
  type SectionInstance,
} from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const { tone, spacing } = frame(settings)

const heading = visibleSetting(settings, "heading")
const introduction = visibleSetting(settings, "introduction")
const columns = numberSetting(settings, "columns", 2, 4, 3)
const showDividers = booleanSetting(settings, "show-dividers", true)

const features = section.data.blocks
  .filter((block) => block.type === "feature")
  .map((block) => ({
    title: visibleSetting(block.settings, "title"),
    description: visibleSetting(block.settings, "description"),
    image: imageSetting(block.settings, "image"),
    imageAlt: attributeSetting(block.settings, "image-alt"),
    label: visibleSetting(block.settings, "label"),
    href: linkSetting(block.settings, "page"),
  }))
  .filter((feature) => feature.title || feature.description || feature.image)

const gridColumns = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
}[columns] ?? "sm:grid-cols-2 lg:grid-cols-3"

const anyImages = features.some((feature) => feature.image)
---

{
  features.length > 0 && (
    <Band tone={tone} spacing={spacing}>
      <Heading heading={heading} lede={introduction} headingHtml class="mb-14" />

      <ul class={cn("grid gap-x-10 gap-y-12", gridColumns)}>
        {features.map((feature) => {
          const Tag = feature.href ? "a" : "div"
          return (
            <li
              class={cn(
                showDividers &&
                  "border-line sm:border-l sm:pl-8 sm:[&:nth-child(2n+1)]:border-l-0 sm:[&:nth-child(2n+1)]:pl-0",
                showDividers &&
                  columns === 3 &&
                  "lg:[&:nth-child(2n+1)]:border-l lg:[&:nth-child(2n+1)]:pl-8 lg:[&:nth-child(3n+1)]:border-l-0 lg:[&:nth-child(3n+1)]:pl-0",
                showDividers &&
                  columns === 4 &&
                  "lg:[&:nth-child(2n+1)]:border-l lg:[&:nth-child(2n+1)]:pl-8 lg:[&:nth-child(4n+1)]:border-l-0 lg:[&:nth-child(4n+1)]:pl-0",
              )}
            >
              <Tag href={feature.href} class="group flex h-full flex-col">
                {anyImages && (
                  <div class="mb-6">
                    {feature.image ? (
                      <Photo
                        src={feature.image}
                        alt={feature.imageAlt}
                        ratio="aspect-[4/3]"
                        class="rounded-card"
                        sizes="(min-width: 1024px) 28vw, (min-width: 640px) 46vw, 92vw"
                      />
                    ) : (
                      <div class="aspect-[4/3] rounded-card bg-surface-sunk" />
                    )}
                  </div>
                )}
                {feature.title && (
                  <h3 class="u-display-sm text-[1.25rem] md:text-[1.375rem]">
                    {feature.title}
                  </h3>
                )}
                {feature.description && (
                  <p class="mt-3 text-[0.9375rem] leading-[1.7] text-ink-muted">
                    {feature.description}
                  </p>
                )}
                {feature.label && feature.href && (
                  <span class="mt-5 inline-flex items-center gap-2.5 text-[0.8125rem]">
                    <span class="u-eyebrow">{feature.label}</span>
                    <span
                      class="h-px w-8 bg-current transition-[width] duration-500 ease-[var(--ease-out-expo)] group-hover:w-12"
                      aria-hidden="true"
                    />
                  </span>
                )}
              </Tag>
            </li>
          )
        })}
      </ul>
    </Band>
  )
}
