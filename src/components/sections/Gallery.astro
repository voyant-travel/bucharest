---
import Band from "~/components/primitives/Band.astro"
import Heading from "~/components/primitives/Heading.astro"
import Photo from "~/components/primitives/Photo.astro"
import { cn } from "~/lib/cn"
import { frame } from "~/lib/presentation"
import {
  attributeSetting,
  choiceSetting,
  imageSetting,
  visibleSetting,
  type SectionInstance,
} from "~/lib/sections"

interface Props {
  section: SectionInstance
}

const { section } = Astro.props
const settings = section.data.settings
const { tone, spacing } = frame(settings)
const layout = choiceSetting(settings, "layout", ["mosaic", "grid", "rail"], "mosaic")

const shots = section.data.blocks
  .filter((block) => block.type === "photograph")
  .map((block) => ({
    src: imageSetting(block.settings, "image"),
    alt: attributeSetting(block.settings, "image-alt"),
  }))
  .filter((shot): shot is { src: string; alt: string | undefined } => Boolean(shot.src))

const caption = visibleSetting(settings, "caption")
const hasHeading = Boolean(
  visibleSetting(settings, "eyebrow") ||
    visibleSetting(settings, "heading") ||
    visibleSetting(settings, "introduction"),
)

/**
 * Rows of two, split 7/5 and then 5/7.
 *
 * Built as rows rather than one twelve-column grid with per-cell aspect
 * ratios. That version reads correctly in the markup and renders as a page of
 * holes: grid rows take the height of their tallest cell, so a landscape
 * beside a portrait leaves the landscape floating in white. Fixing the row
 * height and letting both cells fill it is what makes the pairing line up.
 */
const rows = shots.reduce<Array<typeof shots>>((collected, shot, index) => {
  if (index % 2 === 0) collected.push([shot])
  else collected[collected.length - 1]!.push(shot)
  return collected
}, [])
---

{
  shots.length > 0 && (
    <Band tone={tone} spacing={spacing}>
      {hasHeading && (
        <Heading
          eyebrow={visibleSetting(settings, "eyebrow")}
          heading={visibleSetting(settings, "heading")}
          lede={visibleSetting(settings, "introduction")}
          headingHtml
          class="mb-12"
        />
      )}

      {layout === "mosaic" && (
        <div class="flex flex-col gap-3 md:gap-4">
          {rows.map((row, rowIndex) => (
            <ul
              class={cn(
                "grid gap-3 md:h-[24rem] md:grid-cols-12 md:gap-4 lg:h-[30rem]",
                row.length === 1 && "md:grid-cols-1",
              )}
            >
              {row.map((shot, index) => (
                <li
                  class={cn(
                    "aspect-[4/3] md:aspect-auto md:h-full",
                    row.length === 2 &&
                      (rowIndex % 2 === 0
                        ? index === 0
                          ? "md:col-span-7"
                          : "md:col-span-5"
                        : index === 0
                          ? "md:col-span-5"
                          : "md:col-span-7"),
                  )}
                >
                  <Photo
                    src={shot.src}
                    alt={shot.alt}
                    class="h-full rounded-card"
                    sizes="(min-width: 768px) 50vw, 100vw"
                  />
                </li>
              ))}
            </ul>
          ))}
        </div>
      )}

      {layout === "grid" && (
        <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
          {shots.map((shot) => (
            <li>
              <Photo src={shot.src} alt={shot.alt} ratio="aspect-square" class="rounded-card" sizes="25vw" />
            </li>
          ))}
        </ul>
      )}

      {layout === "rail" && (
        <ul class="u-no-scrollbar -mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 md:-mx-10 md:gap-4 md:px-10">
          {shots.map((shot) => (
            <li class="w-[70vw] shrink-0 snap-start sm:w-[42vw] lg:w-[28vw]">
              <Photo src={shot.src} alt={shot.alt} ratio="aspect-[4/5]" class="rounded-card" sizes="70vw" />
            </li>
          ))}
        </ul>
      )}

      {caption && <p class="mt-5 text-[0.8125rem] text-ink-subtle">{caption}</p>}
    </Band>
  )
}
