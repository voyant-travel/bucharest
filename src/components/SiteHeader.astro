---
import SiteAnnouncement from "~/components/islands/SiteAnnouncement"
import SiteNav, { type NavUtility } from "~/components/islands/SiteNav"
import { cn } from "~/lib/cn"
import type { Messages } from "~/lib/messages"
import type { NavItem } from "~/lib/navigation"
import { utilityMenu, type MenuItem, type SiteSettings } from "~/lib/site"

interface Props {
  /** Read for the `utility` menu, which is a menu rather than a setting. */
  context: { menus?: Record<string, unknown> }
  siteName: string
  logo?: { src: string; alt: string } | undefined
  items: NavItem[]
  settings: SiteSettings
  /** Only a page that opens with a full-bleed hero can host a clear header. */
  overHero: boolean
  messages: Messages
}

const { context, siteName, logo, items, settings, overHero, messages } = Astro.props

/*
 * Only the strings the nav actually renders cross into the island.
 *
 * Everything handed to a `client:` component is serialised into the HTML of
 * every page that mounts it. Passing the whole dictionary shipped roughly a
 * hundred and fifty strings — plural tables, product-page headings, the labels
 * of a booking form that no longer exists — to a component that renders six of
 * them, on every request, twice over once the drawer is counted.
 */
const navMessages = {
  primaryNav: messages.primaryNav,
  menu: messages.menu,
  closeMenu: messages.closeMenu,
  submenu: messages.submenu,
  showAll: messages.showAll,
  backTo: messages.backTo,
  language: messages.language,
  currency: messages.currency,
}

const transparent = overHero && settings.headerStyle === "over-hero"

/**
 * The navigation, in whichever shape reached this component.
 *
 * A publication that predates the panelled menu still sends a flat list with a
 * nested `items` array on each entry. Lifting those children into a single
 * column is enough for the behaviour rule to read them as a dropdown, and it is
 * done here rather than by re-parsing the item, which would strip the
 * provenance the editor selects an authored label by. Without this a site that
 * upgrades the theme without touching its menu silently loses its second level.
 */
const menu: NavItem[] = items.map((item) => {
  const legacy = (item as NavItem & { items?: MenuItem[] }).items
  if (!legacy?.length || (item.columns?.length ?? 0) > 0) return item
  return {
    ...item,
    columns: [{ links: legacy.map(({ label, href }) => ({ label, href })) }],
  }
})

/**
 * The utility bar, assembled from whatever the operator actually published.
 *
 * It is only worth its height when it carries something, so it is built and
 * then discarded if it came out empty — a bar holding one link is worse than
 * no bar, because it still costs the reader a row of the page.
 */
const utilityLinks = utilityMenu(context)

const assembled: NavUtility = {
  phone: settings.phone,
  phoneNote: settings.phoneNote,
  locator: settings.locator,
  account: settings.account,
  languages: settings.languages,
  links: utilityLinks,
  currencies: settings.currencyMode === "switcher" ? settings.currencies : [],
}

const utility: NavUtility | undefined =
  settings.utilityBar &&
  (assembled.phone ||
    assembled.locator ||
    assembled.account ||
    assembled.links.length > 0 ||
    assembled.languages.length > 0 ||
    assembled.currencies.length > 0)
    ? assembled
    : undefined
---

{
  /*
   * A transparent header has to become opaque once the hero has scrolled past,
   * or the navigation ends up as white type on white photography. The sentinel
   * is a zero-height element at the top of the document: when it leaves the
   * viewport the header has left the hero. An IntersectionObserver on that is
   * a single callback at the boundary, where a scroll listener would run on
   * every frame of every scroll for the life of the page.
   */
}
{
  /*
   * The sentinel has height, and is out of flow.
   *
   * A zero-height marker cannot work here: shrunk by the root margin, the
   * observation area starts 72px down the viewport, so a marker sitting at
   * y=0 is never inside it and the header reports itself stuck before the
   * reader has scrolled at all. Giving the sentinel roughly the hero's height
   * makes "still intersecting" mean "still over the photograph", which is the
   * question actually being asked. Absolute so it adds nothing to the layout.
   */
}
<div
  data-header-sentinel
  aria-hidden="true"
  class="pointer-events-none absolute inset-x-0 top-0 h-[80svh]"
></div>

<header
  data-header
  data-transparent={transparent ? "true" : "false"}
  class={cn(
    "group/header fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,box-shadow] duration-500 ease-[var(--ease-out-expo)]",
    transparent
      ? cn(
          "border-b border-transparent bg-transparent text-white",
          "data-[stuck=true]:border-line data-[stuck=true]:bg-[var(--canvas)]/92 data-[stuck=true]:text-ink data-[stuck=true]:backdrop-blur-lg",
          /*
           * An open panel is the second reason to drop the transparency, and
           * the island sets the flag rather than painting a background of its
           * own: two components describing the same opacity is how they end up
           * disagreeing about it.
           */
          "data-[nav-open=true]:border-line data-[nav-open=true]:bg-[var(--canvas)] data-[nav-open=true]:text-ink",
        )
      : cn(
          "bg-[var(--canvas)]/92 text-ink backdrop-blur-lg",
          settings.headerStyle === "bordered" && "border-b border-line",
        ),
  )}
>
  {
    /*
     * Inside the fixed header, not above it: a strip in normal flow would be
     * covered by a header pinned to the top of the viewport. `client:only`
     * because it decides what to render from storage, and a server-rendered
     * strip would flash for anyone who has already dismissed it.
     */
  }
  {settings.announcement && (
    <SiteAnnouncement
      client:only="react"
      announcement={settings.announcement}
      closeLabel={messages.closeAnnouncement}
      defaultLinkLabel={messages.announcementDefaultLink}
    />
  )}

  <SiteNav
    client:load
    items={menu}
    siteName={siteName}
    logo={logo}
    settings={settings}
    messages={navMessages}
    overHero={transparent}
    utility={utility}
  />
</header>

{
  /*
   * The utility bar makes the fixed header taller than the padding the layout
   * reserves for it, so a page that does not open with a photograph gets that
   * height back as flow. It stays put when the bar collapses on scroll: the
   * header is fixed, so a spacer that shrank with it would drag the whole page
   * up under the reader.
   */
  !transparent && (
    <>
      {utility && <div aria-hidden="true" class="hidden h-9 lg:block"></div>}
      {settings.announcement && <div aria-hidden="true" class="h-9"></div>}
    </>
  )
}

<script>
  /*
   * Plain JavaScript, deliberately.
   *
   * A type annotation here is not free: this project's script pipeline emits
   * `document.querySelector < HTMLElement > "[data-header]"` for the annotated
   * form — valid JavaScript that compares two things and discards the call, so
   * `header` becomes `false`, the observer is never created and the header
   * stays transparent forever. It fails silently, with no console error, which
   * is the worst way for a thing to fail. Nothing in here needs types.
   */
  const header = document.querySelector("[data-header]")
  const sentinel = document.querySelector("[data-header-sentinel]")

  if (header && sentinel) {
    // A small root margin flips the state just before the sentinel is fully
    // gone, so the background is already there when the hero edge arrives.
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.dataset.stuck = entry?.isIntersecting ? "false" : "true"
      },
      { rootMargin: "-72px 0px 0px 0px" },
    )
    observer.observe(sentinel)
  }

  /*
   * The header publishes its own height, because nothing else can know it.
   *
   * It is three bands tall with an announcement and a utility bar, two without,
   * and it loses a band when the utility bar hides on scroll — so any sticky
   * thing below it that hard-codes an offset is guessing. The in-page section
   * navs guessed 4.5rem against a header that is routinely 156px, which put the
   * only navigation on a 8,600px page entirely behind the header: present in
   * the DOM, sticky, correct in every respect except visible.
   *
   * Measured rather than computed from the band count, since an announcement
   * can wrap to two lines at narrow widths and a computed sum would be right
   * only at the widths someone happened to check.
   */
  if (header) {
    const publishHeight = () => {
      const height = Math.round(header.getBoundingClientRect().height)
      if (height > 0) {
        document.documentElement.style.setProperty("--header-h", height + "px")
      }
    }
    publishHeight()
    if ("ResizeObserver" in window) {
      new ResizeObserver(publishHeight).observe(header)
    } else {
      /* Older engines still get a correct value on the two events that change it. */
      window.addEventListener("resize", publishHeight)
      window.addEventListener("orientationchange", publishHeight)
    }
  }
</script>
