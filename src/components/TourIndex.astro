---
/**
 * The journeys listing.
 *
 * Two things sit on this page and they are not the same thing. The published
 * products are editorial identity from the publication snapshot, rendered
 * server-side so a crawler and a reader without JavaScript both get the whole
 * collection. The search box above them queries `catalog.search.v1` live,
 * because a catalogue changes far more often than a publication is cut.
 *
 * The search markup and its script are upstream's, unchanged: the hooks the
 * script binds to (`data-tour-search`, `data-tour-search-results`) are a
 * contract between the two, and restyling is not a reason to renegotiate it.
 */
import type { TourIndexContext } from "@voyant-travel/theme"
import JourneyCard from "~/components/cards/JourneyCard.astro"
import { coverOf, namesOf } from "~/lib/catalog"
import { messagesFor } from "~/lib/messages"
import { availableCapability } from "~/lib/tour-capabilities"

interface Props {
  context: TourIndexContext
}

const { context } = Astro.props
const t = messagesFor(context.locale)
const search = availableCapability(context.live, "catalog.search.v1")

/* Only the strings the search script writes, travelling with its form. */
const searchMessages = JSON.stringify({
  searching: t.searching,
  failed: t.requestFailed,
  untitled: t.untitledJourney,
  noMatches: t.noMatches,
  unavailable: t.searchUnavailable,
  results: t.plurals.results,
})

const products = context.products.map((product) => {
  const cover = coverOf(product)
  return {
    slug: product.slug,
    title: product.name,
    region: namesOf(product.destinations).join(" · ") || undefined,
    meta:
      product.shortDescription ??
      (namesOf(product.categories).join(" · ") || undefined),
    image: cover?.src,
    imageAlt: cover?.alt,
    href: `/tours/${encodeURIComponent(product.slug)}`,
  }
})
---

<div class="u-shell pb-24 pt-16 md:pb-32 md:pt-24">
  <header class="max-w-[46rem]">
    <p class="u-eyebrow flex items-center gap-3 text-ink-subtle">
      <span class="h-px w-6 bg-current opacity-45" aria-hidden="true"></span>
      {t.journeys}
    </p>
    <h1 class="u-display mt-6 text-[2.5rem] sm:text-[3.25rem] md:text-[4rem]">
      {context.title}
    </h1>
    {
      context.seo.description && (
        <p class="mt-6 text-[1.0625rem] leading-[1.65] text-ink-muted md:text-[1.125rem]">
          {context.seo.description}
        </p>
      )
    }
  </header>

  {
    search && (
      <form
        class="mt-12 rounded-card border border-line bg-surface p-2 md:rounded-pill"
        data-tour-search
        data-legacy-endpoint={search.endpoint}
        data-locale={context.locale}
        data-messages={searchMessages}
      >
        <div class="flex flex-col gap-2 md:flex-row md:items-center">
          <label class="sr-only" for="tour-query">{t.findAJourney}</label>
          <input
            id="tour-query"
            name="query"
            type="search"
            autocomplete="off"
            placeholder={t.destinationOrExperience}
            class="h-12 flex-1 rounded-pill bg-transparent px-5 text-[0.9375rem] text-ink outline-none placeholder:text-ink-subtle"
          />
          <button
            type="submit"
            class="h-12 shrink-0 rounded-pill bg-accent px-7 text-[0.875rem] font-medium text-accent-ink transition-colors duration-300 hover:bg-accent-hover"
          >
            {t.search}
          </button>
        </div>
        <p
          class="px-5 pb-1 pt-3 text-[0.8125rem] text-ink-subtle empty:hidden"
          data-tour-search-status
          aria-live="polite"
        />
        <ul
          class="grid gap-x-6 gap-y-10 p-4 sm:grid-cols-2 lg:grid-cols-3"
          data-tour-search-results
          hidden
        />
      </form>
    )
  }

  <section class="mt-16" aria-labelledby="published-tours">
    <h2 id="published-tours" class="u-eyebrow text-ink-subtle">{t.featuredJourneys}</h2>

    {
      products.length === 0 ? (
        <p class="u-serif-body mt-8 text-[1.125rem] text-ink-subtle">
          {t.noJourneysPublished}
        </p>
      ) : (
        <ul class="mt-8 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product) => (
            <li>
              <JourneyCard
                image={product.image}
                imageAlt={product.imageAlt}
                title={product.title}
                region={product.region}
                meta={product.meta}
                href={product.href}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
              />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</div>

<script>
  import { createPublicApiClient } from "@voyant-travel/public-api-client"
  import {
    isPublicApiCompatibilityUnavailable,
    searchPublicTours,
  } from "../lib/public-api-catalog"
  import { responseRows, rowText } from "../lib/tour-capabilities"

  const form = document.querySelector("[data-tour-search]")
  if (form instanceof HTMLFormElement) {
    const status = form.querySelector("[data-tour-search-status]")
    const results = form.querySelector("[data-tour-search-results]")

    // The words this script writes come from the component, which is the only
    // layer that knows the publication's language.
    const copy = JSON.parse(form.dataset.messages ?? "{}")
    const fill = (template, values) =>
      String(template ?? "").replaceAll(/\{(\w+)\}/g, (match, key) =>
        key in values ? String(values[key]) : match,
      )
    const plural = (forms, count) => {
      if (!forms) return String(count)
      let category = "other"
      try {
        category = new Intl.PluralRules(form.dataset.locale || "en").select(count)
      } catch {}
      return fill(forms[category] ?? forms.other, { count })
    }
    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      if (!(status instanceof HTMLElement) || !(results instanceof HTMLUListElement)) return
      const data = new FormData(form)
      const query = String(data.get("query") ?? "").trim()
      status.textContent = copy.searching
      results.hidden = true
      try {
        let rows
        try {
          const client = createPublicApiClient({
            managed: true,
            baseUrl: window.location.origin,
          })
          rows = await searchPublicTours(client, {
            query,
            languageTag: form.dataset.locale,
          })
        } catch (canonicalError) {
          // Managed production does not yet route canonical Public API calls.
          // Keep the release-compatible capability until that dispatcher seam
          // lands; connected development succeeds through the call above.
          const endpoint = form.dataset.legacyEndpoint
          if (
            !endpoint ||
            !isPublicApiCompatibilityUnavailable(canonicalError)
          ) throw canonicalError
          const url = new URL(endpoint, window.location.origin)
          if (query) url.searchParams.set("query", query)
          if (form.dataset.locale) {
            url.searchParams.set("locale", form.dataset.locale)
          }
          const response = await fetch(url, {
            headers: { Accept: "application/json" },
          })
          if (!response.ok) {
            throw new Error(fill(copy.failed, { status: response.status }))
          }
          rows = responseRows(await response.json()).map((row) => {
            const slug = rowText(row, "slug")
            const summary = rowText(
              row,
              "shortDescription",
              "summary",
              "description",
            )
            return {
              id: rowText(row, "id", "productId") ?? "",
              ...(slug ? { slug } : {}),
              name: rowText(row, "name", "title") ?? copy.untitled,
              ...(summary ? { summary } : {}),
            }
          })
        }
        results.replaceChildren(
          ...rows.map((row) => {
            const item = document.createElement("li")
            item.className = "border-t border-line pt-4"
            const heading = document.createElement("h3")
            heading.className = "u-display-sm text-[1.0625rem] leading-snug"
            if (row.slug) {
              const link = document.createElement("a")
              link.href = `/tours/${encodeURIComponent(row.slug)}`
              link.textContent = row.name || copy.untitled
              heading.append(link)
            } else {
              heading.textContent = row.name || copy.untitled
            }
            item.append(heading)
            if (row.summary) {
              const blurb = document.createElement("p")
              blurb.className = "mt-2 text-[0.875rem] leading-relaxed text-ink-muted"
              blurb.textContent = row.summary
              item.append(blurb)
            }
            if (!row.slug) item.dataset.productId = row.id
            return item
          }),
        )
        results.hidden = false
        status.textContent =
          rows.length === 0 ? copy.noMatches : plural(copy.results, rows.length)
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : copy.unavailable
      }
    })
  }
</script>
