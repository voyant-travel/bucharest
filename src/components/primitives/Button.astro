---
import { cn } from "~/lib/cn"

interface Props {
  href?: string
  variant?: "solid" | "outline" | "ghost" | "quiet" | "link"
  size?: "sm" | "md" | "lg"
  class?: string
  /** Renders the trailing rule-and-arrow the editorial links use. */
  arrow?: boolean
  type?: "submit" | "button"
}

const {
  href,
  variant = "solid",
  size = "md",
  class: className,
  arrow = false,
  type,
} = Astro.props

const base =
  "group/btn relative inline-flex items-center justify-center gap-2.5 font-sans font-medium tracking-[0.01em] transition-[background-color,color,border-color,transform] duration-300 ease-[var(--ease-out-expo)] disabled:opacity-50 active:translate-y-px"

const sizes = {
  sm: "h-9 px-4 text-[0.8125rem] rounded-pill",
  md: "h-11 px-6 text-[0.875rem] rounded-pill",
  lg: "h-13 px-8 text-[0.9375rem] rounded-pill",
}

const variants = {
  solid: "bg-accent text-accent-ink hover:bg-accent-hover",
  outline:
    "border border-ink/25 text-ink hover:border-ink/70 hover:bg-ink/[0.03]",
  ghost:
    "border border-white/35 text-white backdrop-blur-[2px] bg-white/8 hover:bg-white/18 hover:border-white/60",
  quiet: "bg-ink/[0.06] text-ink hover:bg-ink/[0.11]",
  link: "h-auto rounded-none px-0 text-ink underline-offset-[0.4em] decoration-1 decoration-ink/30 hover:decoration-ink underline",
}

const Tag = href ? "a" : "button"
const classes = cn(
  base,
  variant === "link" ? "" : sizes[size],
  variants[variant],
  className,
)
---

<Tag href={href} type={href ? undefined : (type ?? "button")} class={classes}>
  <slot />
  {
    arrow && (
      <svg
        class="h-3 w-3 shrink-0 transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover/btn:translate-x-1"
        viewBox="0 0 12 12"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M1 6h9M6.5 2 10.5 6l-4 4"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</Tag>
