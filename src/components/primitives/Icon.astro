const path = PATHS[name] ?? PATHS.compass
---

<svg
  class={cn("h-6 w-6 shrink-0", className)}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={path}></path>
</svg>
