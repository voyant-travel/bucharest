---
/**
 * The theme's own icon set.
 *
 * Hand-drawn rather than pulled from an icon package: an icon library ships
 * one stroke weight and one corner treatment, and at the hairline weight this
 * theme uses everywhere, a 2px stroke set reads as a different design system
 * bolted on. It also keeps a React runtime out of pages that are otherwise
 * static.
 */
import { cn } from "~/lib/cn"

interface Props {
  name: string
  class?: string
  strokeWidth?: number
}

const { name, class: className, strokeWidth = 1.25 } = Astro.props

