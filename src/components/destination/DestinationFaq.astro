---
/**
 * The questions, as native disclosures.
 *
 * Deliberately the same idiom as the product page's FAQ — `details` sharing a
 * `name` — so a reader who has met one accordion on this site has met them all.
 * Native disclosure is keyboard-operable, survives find-in-page and prints
 * open, all of which a scripted accordion has to reimplement.
 *
 * This is also where seasonality belongs: as one answer in prose. A month grid
 * would be easy to build from the same data and would be a commercial mistake —
 * it advertises the months not to come, which is the opposite of what a
 * year-round tailor-made operator is selling.
 *
 * The structured data mirrors what is on the page and nothing more. `FAQPage`
 * markup that describes answers a visitor cannot find is a manual-action risk,
 * so it is generated from the same array that renders.
 */
import type { DestinationQuestion } from "~/lib/destination"
import type { Copy } from "./copy"

interface Props {
  questions: DestinationQuestion[]
  copy: Copy
}

const { questions, copy } = Astro.props

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((entry) => ({
    "@type": "Question",
    name: entry.question,
    acceptedAnswer: { "@type": "Answer", text: entry.answer },
  })),
}

/*
 * Operator copy is untrusted text inside a script element, where the parser
 * stops at the first `</script>` regardless of JSON quoting. Escaping the angle
 * bracket is what keeps a stray tag in an answer from ending the block early.
 */
const json = JSON.stringify(schema).replaceAll("<", "\\u003c")
---

<section id="faqs" class="u-shell scroll-mt-40 py-14 md:py-20">
  <div class="grid gap-8 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5">
      <h2 class="u-display-sm text-[1.625rem] md:sticky md:top-40 md:text-[2rem]">
        {copy.faqHeading}
      </h2>
    </div>

    <div class="md:col-span-7">
      <div class="border-t border-line">
        {
          questions.map((entry) => (
            <details name="destinatie-intrebari" class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                <span class="u-serif-body text-[1.0625rem] leading-snug md:text-[1.1875rem]">
                  {entry.question}
                </span>
                <span
                  class="relative mt-1.5 h-3.5 w-3.5 shrink-0 text-ink-subtle"
                  aria-hidden="true"
                >
                  <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current" />
                  <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current transition-transform duration-400 ease-[var(--ease-out-expo)] group-open:scale-y-0" />
                </span>
              </summary>
              <p class="pb-6 pr-10 text-[0.9375rem] leading-[1.75] text-ink-muted">
                {entry.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={json} />
</section>
