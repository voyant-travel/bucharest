---
/**
 * The trips, as a curated rail rather than a grid.
 *
 * A grid says "here is the catalogue, filter it"; a rail says "here are the
 * six we would send you on", which is the promise a tailor-made operator is
 * actually making. It also keeps the section to one screen on a page that
 * already runs to ten, and the overflow has a proper home behind "View all".
 *
 * Every card carries a duration and a from-price. Those two are the questions
 * a reader has before they will click anything, and a card that withholds them
 * sends them back to the rail to open the next one instead.
 *
 * The rail ends with a card that leads to the enquiry, because the honest
 * answer to "none of these is quite it" on this kind of site is a conversation,
 * not a filter.
 */
import Photo from "~/components/primitives/Photo.astro"
import type { DestinationTrip } from "~/lib/destination"
import type { Copy } from "./copy"
import { excerpt, money, nights } from "./format"

interface Props {
  trips: DestinationTrip[]
  allHref?: string | undefined
  enquiry?: string | undefined
  copy: Copy
}

const { trips, allHref, enquiry, copy } = Astro.props

const card = "w-[76vw] max-w-[21rem] shrink-0 snap-start sm:w-[19rem] lg:w-[21rem]"
const sizes = "(min-width: 640px) 21rem, 76vw"
---

<section id="trips" class="u-shell scroll-mt-40 py-14 md:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="u-display-sm text-[1.625rem] md:text-[2rem]">{copy.tripsHeading}</h2>
    {
      allHref && (
        <a
          href={allHref}
          class="u-link text-[0.875rem] text-ink-muted transition-colors duration-300 hover:text-ink"
        >
          {copy.viewAll}
        </a>
      )
    }
  </div>

  {
    /*
     * The gutter is cancelled and re-applied as padding, in the shell's own
     * steps, so the rail scrolls to the edge of a phone screen while its first
     * card still lines up with the heading above it. Padding the scroller
     * instead of indenting it would leave the last card stranded short of the
     * edge, which reads as a rendering fault rather than as more to come.
     */
  }
  <ul class="u-no-scrollbar mt-8 -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 md:-mx-10 md:gap-6 md:px-10 xl:-mx-14 xl:px-14">
    {
      trips.map((trip) => (
        <li class={card}>
          <a href={trip.href} class="group block">
            <div class="relative">
              {trip.image ? (
                <Photo
                  src={trip.image.src}
                  alt={trip.image.alt}
                  ratio="aspect-[4/5]"
                  class="rounded-card"
                  sizes={sizes}
                />
              ) : (
                <div class="aspect-[4/5] rounded-card bg-surface-sunk" />
              )}

              {
                /*
                 * The badge sits on the frame rather than in the caption so it
                 * survives a card with no photograph — the placeholder keeps
                 * the same box — and so duration is legible while the reader is
                 * still scanning pictures.
                 */
              }
              {trip.nights !== undefined && (
                <span class="u-eyebrow absolute left-3 top-3 z-[2] rounded-pill bg-[var(--canvas)]/92 px-3 py-2 text-ink backdrop-blur-sm">
                  {nights(trip.nights, copy)}
                </span>
              )}
            </div>

            <div class="mt-4">
              {trip.region && <p class="u-eyebrow text-ink-subtle">{trip.region}</p>}
              <h3
                class:list={[
                  "u-display-sm text-[1.1875rem] transition-colors duration-300 group-hover:text-accent md:text-[1.3125rem]",
                  trip.region && "mt-2",
                ]}
              >
                {trip.title}
              </h3>
              {trip.excerpt && (
                <p class="mt-2 text-[0.875rem] leading-[1.65] text-ink-muted">
                  {excerpt(trip.excerpt)}
                </p>
              )}
              {trip.priceFrom !== undefined && (
                <p class="mt-3 text-[0.875rem] text-ink">
                  {copy.from}{" "}
                  <span class="font-medium">{money(trip.priceFrom, trip.currency)}</span>{" "}
                  <span class="text-ink-subtle">{copy.perPerson}</span>
                </p>
              )}
            </div>
          </a>
        </li>
      ))
    }

    {
      enquiry && (
        <li class={card}>
          <a
            href={enquiry}
            class="group flex h-full min-h-[22rem] flex-col justify-end rounded-card border border-line bg-surface-sunk p-6 transition-colors duration-300 hover:border-ink/30"
          >
            <p class="u-eyebrow text-ink-subtle">{copy.tailoredEyebrow}</p>
            <h3 class="u-display-sm mt-3 text-[1.3125rem]">{copy.tailoredHeading}</h3>
            <p class="mt-3 text-[0.875rem] leading-[1.65] text-ink-muted">
              {copy.tailoredBody}
            </p>
            <span class="u-eyebrow mt-6 inline-flex items-center gap-2.5 text-ink">
              <span class="h-px w-5 bg-current" aria-hidden="true" />
              {copy.requestQuote}
            </span>
          </a>
        </li>
      )
    }
  </ul>
</section>
