---
import type { ThemePageContext } from "@voyant-travel/theme"

interface Props {
  context: ThemePageContext
}

const { context } = Astro.props
// Content pages carry a summary; use it as the meta description so published
// storefront pages are not indexed without one.
const description = context.kind === "content" ? context.summary : undefined
---

<!doctype html>
<html lang={context.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{context.title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header>
      <a class="wordmark" href="/">{context.site.name}</a>
      <nav>
        {
          context.navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    font-family: system-ui, sans-serif;
    line-height: 1.55;
  }
  header {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid #e5e5e5;
  }
  .wordmark {
    font-weight: 600;
    text-decoration: none;
    color: inherit;
  }
  nav {
    display: flex;
    gap: 1rem;
  }
  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3rem 2rem;
  }
</style>
