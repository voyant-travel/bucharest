---
import { cleanStega, type ThemePageContext } from "@voyant-travel/theme"
import SiteFooter from "~/components/SiteFooter.astro"
import SiteHeader from "~/components/SiteHeader.astro"
import { cn } from "~/lib/cn"
import { messagesFor } from "~/lib/messages"
import { navItems } from "~/lib/navigation"
import {
  absoluteUrl,
  alternateLinks,
  breadcrumbLd,
  breadcrumbTrail,
  defaultAlternate,
  ldScript,
  organizationLd,
  pageEntityLd,
  webPageLd,
  webSiteLd,
} from "~/lib/seo"
import { footerMenus, primaryMenu, readSettings } from "~/lib/site"
import "~/styles/global.css"

interface Props {
  context: ThemePageContext
  /** The home page is composed of sections, so it manages its own rhythm. */
  authoredHome?: boolean
  /** The page opens with a full-bleed image, so the header may sit over it. */
  overHero?: boolean
}

const { context, authoredHome = false, overHero = false } = Astro.props

// Authored SEO wins, because it is the one description an operator wrote on
// purpose. A content page falls back to its own summary so a published page is
// never indexed without one; a collection page has no equivalent prose to
// borrow, and an invented description would be worse than none.
const description =
  context.seo.description ??
  (context.kind === "content" ? context.summary : undefined)

// Everything in `head` is an attribute or a title, never a text node, so all
// of it is stripped of provenance.
const documentTitle = cleanStega(context.seo.title)
const metadataDescription = description ? cleanStega(description) : undefined
const openGraphTitle = context.openGraph?.title
  ? cleanStega(context.openGraph.title)
  : undefined
const openGraphDescription = context.openGraph?.description
  ? cleanStega(context.openGraph.description)
  : undefined
const openGraphImageAlt = context.openGraph?.image?.alt
  ? cleanStega(context.openGraph.image.alt)
  : undefined

const settings = readSettings(context.settings ?? {})
// The theme's own labels, in the language this publication resolved to.
const t = messagesFor(context.locale)
const navigation = primaryMenu(context)
/*
 * The header reads the panelled shape, the footer the flat one. They are the
 * same published menu seen at two depths: a footer column is a sitemap and has
 * no use for a mega panel's cards, while a header that flattened them would
 * throw away the only structure that makes a 200-destination catalogue
 * navigable.
 */
const menu = navItems(
  (context as { menus?: Record<string, unknown> }).menus?.primary ??
    (context as { navigation?: unknown }).navigation,
)
const columns = footerMenus(context)
const injection = "codeInjection" in context ? context.codeInjection : undefined
const canonical = new URL(context.path, Astro.url).toString()
const origin = Astro.url.origin

/*
 * The image, resolved against the request origin before it is advertised.
 * Both Open Graph and the Twitter card are read by a fetcher that has no
 * document to resolve a relative path against, so `/og/cover.jpg` published by
 * an operator becomes nothing at all in a preview unless it is made absolute
 * here. A source that will not parse is dropped rather than emitted broken:
 * a card with no image degrades to `summary`, a card with a dead one does not.
 */
const openGraphImage = context.openGraph?.image
  ? absoluteUrl(context.openGraph.image.src, origin)
  : undefined
/* Dimensions belong to an image that survived resolution, not to the field. */
const openGraphImageSize = openGraphImage ? context.openGraph?.image : undefined

/*
 * The card reuses what Open Graph already resolved and falls back to the
 * document's own title and description rather than recomputing either. A
 * Twitter card with no title falls back to the `<title>` anyway, so the only
 * thing a second derivation could add is a way for the two to disagree.
 */
const twitterTitle = openGraphTitle ?? documentTitle
const twitterDescription = openGraphDescription ?? metadataDescription

/**
 * Whether a crawler should be told anything about this page beyond "go away".
 *
 * Structured data, and an `hreflang` cluster, describe a page for an index
 * this one has asked to stay out of. Emitting them on a `noindex` page is at
 * best ignored; at worst it feeds an entity graph from a page nobody can
 * reach, which is how a soft 404 acquires a breadcrumb.
 */
const indexable = !context.seo.noIndex && context.kind !== "notFound"

const organization = indexable
  ? organizationLd(settings, context.site.name, origin)
  : undefined
const webSite = indexable
  ? webSiteLd(context.site.name, origin, context.locale)
  : undefined
const webPage = indexable
  ? webPageLd(
      {
        path: context.path,
        title: context.title,
        description,
        locale: context.locale,
      },
      origin,
    )
  : undefined
/*
 * `journeys` and `cruises` rather than the "All journeys" / "Back to cruises"
 * wording on the visible link: a breadcrumb crumb names a destination, and the
 * two labels point at the same two routes the templates already link to.
 */
const breadcrumb = indexable
  ? breadcrumbLd(
      breadcrumbTrail(context, { journeys: t.journeys, cruises: t.cruises }),
      origin,
    )
  : undefined
/*
 * No `FAQPage` is built here. The destination template already emits one from
 * the questions it renders, and a second `FAQPage` on the same document is not
 * additive — the two compete to describe the page and a validator reports the
 * conflict rather than merging them.
 */
const entity = indexable ? pageEntityLd(context, origin) : undefined

const alternates = indexable ? alternateLinks(settings.languages, origin) : []
const fallbackAlternate = defaultAlternate(alternates)

/**
 * The operator's accent, applied as a variable override rather than written
 * into a rule. `--accent-hover` is derived from it so a custom accent still
 * has a hover state; `--accent-ink` is left alone, because each palette
 * carries a foreground already checked against its own accent and guessing a
 * new one from an arbitrary hex would be a coin flip on legibility.
 */
const accentStyle = settings.accent
  ? `--accent:${settings.accent};--accent-hover:color-mix(in oklab, ${settings.accent} 84%, white);`
  : undefined
---

<!doctype html>
<html
  lang={context.locale}
  data-palette={settings.palette}
  data-corners={settings.corners}
  style={accentStyle}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />

    <title>{documentTitle}</title>
    {metadataDescription && (
      <meta name="description" content={metadataDescription} />
    )}
    {
      /*
       * A 404 is never indexable, whatever the publication says. The context
       * for a missing page is synthesized rather than authored, so it can
       * reach a theme without `noIndex` set, and a soft 404 in the index is
       * worse for the operator than the missing page was.
       */
      (context.seo.noIndex || context.kind === "notFound") && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    {
      /*
       * The two faces that draw above-the-fold type, fetched in parallel with
       * the stylesheet instead of after it. `crossorigin` is required even
       * same-origin: a font request is anonymous, and without it the browser
       * downloads the file a second time.
       */
    }
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta
      property="og:type"
      content={context.kind === "content" ? "article" : "website"}
    />
    <meta property="og:site_name" content={cleanStega(context.site.name)} />
    <meta property="og:url" content={canonical} />
    {openGraphTitle && <meta property="og:title" content={openGraphTitle} />}
    {openGraphDescription && (
      <meta property="og:description" content={openGraphDescription} />
    )}
    {openGraphImage && <meta property="og:image" content={openGraphImage} />}
    {openGraphImage && openGraphImageAlt && (
      <meta property="og:image:alt" content={openGraphImageAlt} />
    )}
    {openGraphImageSize?.width && (
      <meta
        property="og:image:width"
        content={String(openGraphImageSize.width)}
      />
    )}
    {openGraphImageSize?.height && (
      <meta
        property="og:image:height"
        content={String(openGraphImageSize.height)}
      />
    )}
    <meta
      name="twitter:card"
      content={openGraphImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={twitterTitle} />
    {twitterDescription && (
      <meta name="twitter:description" content={twitterDescription} />
    )}
    {openGraphImage && <meta name="twitter:image" content={openGraphImage} />}
    {openGraphImage && openGraphImageAlt && (
      <meta name="twitter:image:alt" content={openGraphImageAlt} />
    )}

    {
      /*
       * The operator's own language versions, mirroring the switcher this page
       * renders. `x-default` points at the one they marked current, because
       * that is the version their bare hostname serves.
       */
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }
    {fallbackAlternate && (
      <link rel="alternate" hreflang="x-default" href={fallbackAlternate.href} />
    )}

    {
      /*
       * One script per entity rather than one graph, so a page that can only
       * describe some of itself still emits the parts it can. The nodes are
       * joined by `@id`, which is what lets a consumer walk from the page to
       * the site to the agency without them sharing a payload.
       */
      organization && (
        <script type="application/ld+json" set:html={ldScript(organization)} />
      )
    }
    {webSite && (
      <script type="application/ld+json" set:html={ldScript(webSite)} />
    )}
    {webPage && (
      <script type="application/ld+json" set:html={ldScript(webPage)} />
    )}
    {breadcrumb && (
      <script type="application/ld+json" set:html={ldScript(breadcrumb)} />
    )}
    {entity && <script type="application/ld+json" set:html={ldScript(entity)} />}

    {
      /*
       * Operator-supplied markup, verbatim. A theme's only job is to place
       * each slot where it belongs; escaping it here would be the same bug as
       * trusting it, and would silently break the analytics and consent tags
       * operators depend on.
       */
      injection?.head && <Fragment set:html={injection.head} />
    }
  </head>

  <body class={cn(settings.grain && "u-grain")}>
    {injection?.bodyStart && <Fragment set:html={injection.bodyStart} />}

    <a
      href="#main"
      class="sr-only rounded-pill bg-accent px-5 py-3 text-[0.875rem] text-accent-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]"
    >
      {t.skipToContent}
    </a>

    <SiteHeader
      context={context}
      siteName={context.site.name}
      logo={context.site.logo}
      items={menu}
      settings={settings}
      overHero={overHero}
      messages={t}
    />

    {
      /*
       * A page that does not open with a full-bleed image starts below the
       * fixed header rather than under it. The ones that do pad themselves,
       * because their photograph is meant to run to the top of the window.
       */
    }
    <main
      id="main"
      class:list={[
        !overHero && "pt-[4.5rem] md:pt-[5.25rem]",
        { "authored-home": authoredHome },
      ]}
    >
      <slot />
    </main>

    <SiteFooter
      siteName={context.site.name}
      logo={context.site.logo}
      columns={columns}
      settings={settings}
      fallbackItems={navigation}
      messages={t}
    />

    {injection?.bodyEnd && <Fragment set:html={injection.bodyEnd} />}
  </body>
</html>
